---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { wa } from '../lib/wa';

interface Crumb {
  label: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  h1: string;
  lead?: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  /** Booking flow opened by the call to action. */
  flow?: string;
  flowService?: string;
  cta?: string;
}

const { title, description, h1, lead, crumbs = [], schema = [], flow = 'pickup', flowService, cta = 'Book a pickup' } = Astro.props;
const trail = [{ label: 'Home', href: '/' }, ...crumbs];
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [...trail, { label: h1, href: Astro.url.pathname }].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, site.url).href,
  })),
};
---

<Base title={title} description={description} schema={[breadcrumb, ...schema]}>
  <article class="page">
    <header class="page__head">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          {
            trail.map((c) => (
              <>
                <a href={c.href}>{c.label}</a>
                <span aria-hidden="true">/</span>
              </>
            ))
          }
          <span aria-current="page">{h1}</span>
        </nav>
        <h1 class="h1">{h1}</h1>
        {lead && <p class="lead">{lead}</p>}
        <div class="page__cta">
          <a class="btn btn--wa" href={wa()} target="_blank" rel="noopener" data-flow={flow} data-flow-service={flowService}>
            <Icon name="whatsapp" size={20} />
            {cta}
          </a>
          <slot name="actions" />
        </div>
      </div>
    </header>

    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>

    <section class="band">
      <div class="container">
        <h2 class="h2">Ready when you are.</h2>
        <p class="lead">Free pickup and delivery within {site.freeRadiusKm} km of {site.base.label}. Booking takes under a minute.</p>
        <a class="btn btn--white" href={wa()} target="_blank" rel="noopener" data-flow={flow} data-flow-service={flowService}>
          <Icon name="whatsapp" size={20} />
          {cta}
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .page__head {
    padding-block: clamp(40px, 6vw, 72px) clamp(32px, 4vw, 48px);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .page__head .lead {
    max-width: 680px;
    margin: 16px auto 0;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 14px;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  .page__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
  }

  .prose {
    max-width: 760px;
    margin-inline: auto;
    padding-block: clamp(40px, 6vw, 72px);
  }

  .prose :global(h2) {
    margin-top: 48px;
    color: var(--ink);
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
    line-height: 1.2;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 28px;
    color: var(--ink);
    font-size: 1.15rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 14px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-top: 8px;
  }

  .prose :global(a) {
    color: var(--brand-600);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(.facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .prose :global(.facts li) {
    margin: 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  .prose :global(.facts span) {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }

  .prose :global(.facts strong) {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.35;
  }

  .prose :global(.links) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
    margin-top: 20px;
    padding: 0;
    list-style: none;
  }

  .prose :global(.links li) {
    margin: 0;
  }

  .prose :global(.links a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .prose :global(.links a:hover) {
    border-color: var(--brand);
  }

  .prose :global(.links small) {
    display: block;
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }

  .prose :global(.note) {
    color: var(--muted);
    font-size: 14px;
  }

  .band {
    padding-block: clamp(48px, 7vw, 80px);
    background: var(--brand);
    color: var(--white);
    text-align: center;
  }

  .band .h2 {
    color: var(--white);
  }

  .band .lead {
    max-width: 560px;
    margin: 12px auto 28px;
    color: rgba(255, 255, 255, 0.9);
  }
</style>
