---
import QRCode from 'qrcode';
import Icon from './Icon.astro';
import { site } from '../config';

// Scanned on a phone, this opens the site with the install sheet already showing.
const installUrl = `${site.url}/?install=1`;
const qrSvg = await QRCode.toString(installUrl, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0c0c0c', light: '#ffffff' },
});
---

<dialog class="pwa" data-pwa aria-labelledby="pwa-title" transition:persist="pwa-prompt">
  <div class="pwa__sheet" tabindex="-1" autofocus>
    <button class="pwa__close" type="button" data-pwa-close aria-label="Close">
      <Icon name="x" size={20} />
    </button>

    <img src="/icon-192.png" alt="" width="64" height="64" class="pwa__icon" />
    <h2 id="pwa-title" data-pwa-title>Get the dhobermans app</h2>
    <p class="pwa__sub" data-pwa-sub>Book pickups in a few taps, right from your home screen.</p>

    <!-- Desktop: continue on your phone -->
    <figure class="pwa__mode pwa__qr" data-mode="desktop" hidden>
      <div class="pwa__qrframe" set:html={qrSvg} role="img" aria-label="QR code that opens dhobermans.com on your phone"></div>
      <figcaption>Point your phone camera at the code</figcaption>
    </figure>

    <!-- iPhone and iPad -->
    <div class="pwa__mode pwa__steps" data-mode="ios" hidden>
      <ol>
        <li>Tap <strong>Share</strong> <span class="pwa__glyph"><Icon name="share-ios" size={14} /></span> in your browser</li>
        <li>Choose <strong>Add to Home Screen</strong></li>
        <li>Tap <strong>Add</strong></li>
      </ol>
      <p class="pwa__hint">In Safari, Share may sit under the ••• menu.</p>
    </div>

    <!-- Android without the browser's install event -->
    <div class="pwa__mode pwa__steps" data-mode="android" hidden>
      <ol>
        <li>Tap the <strong>⋮</strong> menu in your browser</li>
        <li>Choose <strong>Install app</strong> or <strong>Add to Home screen</strong></li>
        <li>Confirm</li>
      </ol>
    </div>

    <!-- In-app browsers (WhatsApp, Instagram, Facebook) cannot install -->
    <div class="pwa__mode pwa__steps" data-mode="inapp" hidden>
      <ol>
        <li>Tap <strong>⋮</strong> or <strong>•••</strong> at the top</li>
        <li>Choose <strong>Open in browser</strong></li>
        <li>Install from your browser</li>
      </ol>
      <button type="button" class="btn btn--ghost btn--sm" data-pwa-copy>Copy link</button>
    </div>

    <ul class="pwa__perks" data-perks>
      <li><span><Icon name="calendar" size={18} /></span>Book in a minute</li>
      <li><span><Icon name="whatsapp" size={18} /></span>Straight to WhatsApp</li>
      <li><span><Icon name="wifi" size={18} /></span>Fast on any network</li>
    </ul>

    <div class="pwa__actions">
      <button type="button" class="btn btn--primary btn--block" data-pwa-install hidden>
        <Icon name="download" size={18} /> <span data-install-label>Install app</span>
      </button>
      <button type="button" class="pwa__later" data-pwa-later>Not now</button>
    </div>
  </div>
</dialog>

<style>
  .pwa {
    width: calc(100% - 32px);
    max-width: 440px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  .pwa::backdrop {
    background: rgba(10, 14, 22, 0.38);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
  }

  .pwa[open] .pwa__sheet {
    animation: pwa-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pwa__sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 36px 28px 20px;
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: 0 40px 100px -30px rgba(0, 31, 77, 0.45);
    text-align: center;
    outline: none;
  }

  .pwa__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
  }

  .pwa__icon {
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 24px -10px rgba(0, 123, 255, 0.6);
  }

  .pwa__sheet h2 {
    margin-top: 16px;
    font-size: 22px;
  }

  .pwa__sub {
    max-width: 320px;
    margin-top: 6px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .pwa__qr {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 24px 0 0;
  }

  .pwa__qrframe {
    width: 184px;
    height: 184px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .pwa__qrframe :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pwa__qr figcaption {
    color: var(--muted);
    font-size: 14px;
  }

  .pwa__steps {
    width: 100%;
    margin-top: 22px;
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .pwa__steps ol {
    display: grid;
    gap: 10px;
    width: fit-content;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    counter-reset: s;
    text-align: left;
  }

  .pwa__steps li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    counter-increment: s;
  }

  .pwa__steps li::before {
    content: counter(s);
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
  }

  .pwa__steps .btn {
    margin-top: 14px;
  }

  .pwa__hint {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
  }

  .pwa__glyph {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--brand);
    vertical-align: middle;
    box-shadow: var(--shadow-sm);
  }

  .pwa__perks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    width: 100%;
    margin: 24px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .pwa__perks li {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }

  .pwa__perks li > span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
  }

  .pwa__actions {
    display: grid;
    gap: 4px;
    width: 100%;
    margin-top: 22px;
  }

  .pwa__later {
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }

  .pwa__later:hover {
    color: var(--ink);
  }

  @keyframes pwa-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .pwa {
      width: 100%;
      max-width: none;
      max-height: 100%;
      margin: auto 0 0;
    }

    .pwa__sheet {
      max-height: 92dvh;
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
  }
</style>

<script>
  type InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }> };
  type Mode = 'native' | 'ios' | 'android' | 'inapp' | 'desktop';

  const STORAGE_KEY = 'dhobermans:pwa-prompt';
  const ENGAGE_DELAY_MS = 10000;

  // Remembered per browser. If storage is unavailable (private mode), never auto-show.
  const store = {
    seen(): boolean {
      try {
        return localStorage.getItem(STORAGE_KEY) !== null;
      } catch {
        return true;
      }
    },
    mark(value: string) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ value, at: new Date().toISOString() }));
      } catch {
        /* storage unavailable */
      }
    },
  };

  const ua = navigator.userAgent;
  const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/i.test(ua);
  const inAppBrowser = /FBAN|FBAV|FB_IAB|Instagram|Line\/|WhatsApp|Snapchat|; wv\)/i.test(ua);
  const isStandalone = () =>
    window.matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;

  let installEvent: InstallEvent | null = null;
  let engaged = false;

  const mode = (): Mode => {
    if (isIOS) return inAppBrowser ? 'inapp' : 'ios';
    if (isAndroid) return installEvent ? 'native' : inAppBrowser ? 'inapp' : 'android';
    return 'desktop';
  };

  const canShow = () => !isStandalone() && !window.location.pathname.startsWith('/app');
  const dialog = () => document.querySelector<HTMLDialogElement>('[data-pwa]');

  const syncTriggers = () => {
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => (el.hidden = !canShow()));
  };

  const close = () => {
    const d = dialog();
    if (d?.open) d.close();
  };

  const open = () => {
    const d = dialog();
    if (!d || d.open || !canShow()) return;
    const m = mode();
    d.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== m));
    const install = d.querySelector<HTMLElement>('[data-pwa-install]')!;
    install.hidden = !installEvent; // native install, also offered on desktop when the browser supports it
    d.querySelector('[data-install-label]')!.textContent = m === 'desktop' ? 'Install on this computer' : 'Install app';
    d.querySelector('[data-pwa-title]')!.textContent = m === 'desktop' ? 'Take dhobermans with you' : 'Get the dhobermans app';
    d.querySelector('[data-pwa-sub]')!.textContent =
      m === 'desktop' ? 'Scan to install the app on your phone and book pickups in a few taps.' : 'Book pickups in a few taps, right from your home screen.';
    d.querySelector<HTMLElement>('[data-pwa-later]')!.textContent = 'Not now';
    store.mark('shown');
    d.showModal();
  };

  const isTyping = () => {
    const el = document.activeElement;
    return !!el && (el.matches('input, textarea, select') || (el as HTMLElement).isContentEditable);
  };

  const maybeAutoOpen = () => {
    if (!engaged || store.seen() || !canShow()) return;
    if (window.location.pathname.startsWith('/offline')) return;
    if (document.querySelector('dialog[open]')) return;
    if (isTyping()) {
      // Never interrupt someone filling in a field: try again shortly after they leave it.
      document.addEventListener('focusout', () => window.setTimeout(maybeAutoOpen, 1500), { once: true });
      return;
    }
    open();
  };

  const engage = () => {
    if (engaged) return;
    engaged = true;
    window.removeEventListener('scroll', onScroll);
    maybeAutoOpen();
  };
  const onScroll = () => {
    if (window.scrollY > window.innerHeight * 0.6) engage();
  };

  if (!store.seen() && !isStandalone()) {
    window.setTimeout(engage, ENGAGE_DELAY_MS);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault(); // use our own prompt instead of the browser's mini-infobar
    installEvent = e as InstallEvent;
    const d = dialog();
    if (d?.open) {
      // Upgrade an open sheet from instructions to one-tap install.
      d.close();
      open();
    }
  });

  window.addEventListener('appinstalled', () => {
    installEvent = null;
    store.mark('installed');
    close();
    syncTriggers();
  });

  const d = dialog();
  if (d) {
    d.querySelector('[data-pwa-close]')?.addEventListener('click', close);
    d.querySelector('[data-pwa-later]')?.addEventListener('click', close);
    d.addEventListener('click', (e) => {
      if (e.target === d) close();
    });
    d.querySelector('[data-pwa-install]')?.addEventListener('click', async () => {
      if (!installEvent) return;
      const ev = installEvent;
      installEvent = null;
      await ev.prompt();
      const { outcome } = await ev.userChoice;
      store.mark(outcome === 'accepted' ? 'installed' : 'dismissed');
      close();
    });
    d.querySelector('[data-pwa-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(window.location.origin + '/');
        btn.textContent = 'Link copied';
      } catch {
        btn.textContent = window.location.origin + '/';
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    syncTriggers();
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      el.addEventListener('click', open);
    });
    // Arrived from the desktop QR code or a shared install link: show the sheet straight away.
    const params = new URLSearchParams(window.location.search);
    if (params.get('install') === '1') {
      params.delete('install');
      const qs = params.toString();
      history.replaceState(history.state, '', window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash);
      window.setTimeout(open, 600);
    }
  });

  // Offline support.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    const register = () => navigator.serviceWorker.register('/sw.js').catch(() => {});
    if (document.readyState === 'complete') register();
    else window.addEventListener('load', register, { once: true });
  }
</script>
