---
import QRCode from 'qrcode';
import Icon from './Icon.astro';
import { site } from '../config';

// Scanned on a phone, this opens the site with the install sheet already showing.
const installUrl = `${site.url}/?install=1`;
const qrSvg = await QRCode.toString(installUrl, {
  type: 'svg',
  margin: 1,
  errorCorrectionLevel: 'M',
  color: { dark: '#0c0c0c', light: '#ffffff' },
});
const sendToPhone = `https://wa.me/?text=${encodeURIComponent(`dhobermans app: ${installUrl}`)}`;
---

<dialog class="pwa" data-pwa aria-labelledby="pwa-title" transition:persist="pwa-prompt">
  <div class="pwa__sheet" tabindex="-1" autofocus>
    <button class="pwa__close" type="button" data-pwa-close aria-label="Close">
      <Icon name="x" size={20} />
    </button>

    <div class="pwa__head">
      <img src="/icon-192.png" alt="" width="56" height="56" class="pwa__icon" />
      <div>
        <h2 id="pwa-title" data-pwa-title>Get the dhobermans app</h2>
        <p data-pwa-sub>Book a pickup in a few taps. No app store, no big download.</p>
      </div>
    </div>

    <!-- Desktop: continue on your phone -->
    <div class="pwa__mode pwa__desktop" data-mode="desktop" hidden>
      <div class="pwa__qr" set:html={qrSvg} role="img" aria-label="QR code that opens dhobermans.com on your phone"></div>
      <div class="pwa__qrtext">
        <p><strong>Scan with your phone camera.</strong> The site opens with the app ready to install.</p>
        <a class="pwa__link" href={sendToPhone} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={16} /> Or send the link to yourself on WhatsApp
        </a>
      </div>
    </div>

    <ul class="pwa__perks" data-perks>
      <li><span><Icon name="calendar" size={16} /></span>Book a pickup in under a minute</li>
      <li><span><Icon name="whatsapp" size={16} /></span>Your request arrives on our WhatsApp instantly</li>
      <li><span><Icon name="wifi" size={16} /></span>Opens from your home screen, even on a slow connection</li>
    </ul>

    <!-- iPhone and iPad -->
    <div class="pwa__mode pwa__steps" data-mode="ios" hidden>
      <p>To install on iPhone or iPad:</p>
      <ol>
        <li>
          Tap the <strong>Share</strong> button <span class="pwa__glyph"><Icon name="share-ios" size={15} /></span>. In Safari it is in the toolbar
          (sometimes under <strong>•••</strong>); in Chrome it is in the address bar.
        </li>
        <li>Choose <strong>Add to Home Screen</strong>, then tap <strong>Add</strong>.</li>
      </ol>
      <p class="pwa__hint">Don't see it? Open dhobermans.com in Safari and try again.</p>
    </div>

    <!-- Android without the browser's install event -->
    <div class="pwa__mode pwa__steps" data-mode="android" hidden>
      <p>To install on Android:</p>
      <ol>
        <li>Tap the <strong>⋮</strong> menu at the top right of your browser.</li>
        <li>Choose <strong>Install app</strong> or <strong>Add to Home screen</strong>, then confirm.</li>
      </ol>
    </div>

    <!-- In-app browsers (WhatsApp, Instagram, Facebook) cannot install -->
    <div class="pwa__mode pwa__steps" data-mode="inapp" hidden>
      <p>You're viewing this inside another app.</p>
      <ol>
        <li>Tap <strong>⋮</strong> or <strong>•••</strong> and choose <strong>Open in browser</strong>.</li>
        <li>Then install dhobermans from your browser.</li>
      </ol>
      <button type="button" class="btn btn--ghost btn--sm" data-pwa-copy>Copy link</button>
    </div>

    <div class="pwa__actions">
      <button type="button" class="btn btn--primary btn--block" data-pwa-install hidden>
        <Icon name="download" size={18} /> <span data-install-label>Install app</span>
      </button>
      <button type="button" class="btn btn--ghost btn--block" data-pwa-later>Not now</button>
    </div>
  </div>
</dialog>

<style>
  .pwa {
    width: calc(100% - 32px);
    max-width: 460px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  .pwa::backdrop {
    background: rgba(12, 12, 12, 0.5);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .pwa[open] .pwa__sheet {
    animation: pwa-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pwa__sheet {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 28px 24px 24px;
    border-radius: 20px;
    background: var(--white);
    box-shadow: var(--shadow-lg);
    outline: none;
  }

  .pwa__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
  }

  .pwa__head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-right: 40px;
  }

  .pwa__icon {
    flex: none;
    border-radius: 14px;
  }

  .pwa__head h2 {
    font-size: 21px;
  }

  .pwa__head p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.4;
  }

  .pwa__desktop {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 22px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .pwa__qr {
    flex: none;
    width: 132px;
    height: 132px;
  }

  .pwa__qr :global(svg) {
    width: 100%;
    height: 100%;
  }

  .pwa__qrtext {
    display: grid;
    gap: 10px;
    font-size: 15px;
  }

  .pwa__qrtext strong {
    color: var(--ink);
  }

  .pwa__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--wa);
    font-size: 14px;
    font-weight: 600;
  }

  .pwa__perks {
    display: grid;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .pwa__perks li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  .pwa__perks li > span {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--brand-50);
    color: var(--brand);
  }

  .pwa__steps {
    margin-top: 18px;
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    font-size: 15px;
  }

  .pwa__steps > p:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  .pwa__steps ol {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding-left: 20px;
  }

  .pwa__steps .btn {
    margin-top: 12px;
  }

  .pwa__hint {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
  }

  .pwa__glyph {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--white);
    color: var(--brand);
    vertical-align: middle;
    box-shadow: var(--shadow-sm);
  }

  .pwa__actions {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  @keyframes pwa-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .pwa {
      width: 100%;
      max-width: none;
      max-height: 100%;
      margin: auto 0 0;
    }

    .pwa__sheet {
      max-height: 92dvh;
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
      border-radius: 20px 20px 0 0;
    }
  }
</style>

<script>
  type InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }> };
  type Mode = 'native' | 'ios' | 'android' | 'inapp' | 'desktop';

  const STORAGE_KEY = 'dhobermans:pwa-prompt';
  const ENGAGE_DELAY_MS = 10000;

  // Remembered per browser. If storage is unavailable (private mode), never auto-show.
  const store = {
    seen(): boolean {
      try {
        return localStorage.getItem(STORAGE_KEY) !== null;
      } catch {
        return true;
      }
    },
    mark(value: string) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ value, at: new Date().toISOString() }));
      } catch {
        /* storage unavailable */
      }
    },
  };

  const ua = navigator.userAgent;
  const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/i.test(ua);
  const inAppBrowser = /FBAN|FBAV|FB_IAB|Instagram|Line\/|WhatsApp|Snapchat|; wv\)/i.test(ua);
  const isStandalone = () =>
    window.matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;

  let installEvent: InstallEvent | null = null;
  let engaged = false;

  const mode = (): Mode => {
    if (isIOS) return inAppBrowser ? 'inapp' : 'ios';
    if (isAndroid) return installEvent ? 'native' : inAppBrowser ? 'inapp' : 'android';
    return 'desktop';
  };

  const canShow = () => !isStandalone() && !window.location.pathname.startsWith('/app');
  const dialog = () => document.querySelector<HTMLDialogElement>('[data-pwa]');

  const syncTriggers = () => {
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => (el.hidden = !canShow()));
  };

  const close = () => {
    const d = dialog();
    if (d?.open) d.close();
  };

  const open = () => {
    const d = dialog();
    if (!d || d.open || !canShow()) return;
    const m = mode();
    d.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== m));
    const install = d.querySelector<HTMLElement>('[data-pwa-install]')!;
    install.hidden = !installEvent; // native install, also offered on desktop when the browser supports it
    d.querySelector('[data-install-label]')!.textContent = m === 'desktop' ? 'Install on this computer' : 'Install app';
    d.querySelector('[data-pwa-title]')!.textContent = m === 'desktop' ? 'Take dhobermans with you' : 'Get the dhobermans app';
    d.querySelector('[data-pwa-sub]')!.textContent =
      m === 'desktop' ? 'Install the app on your phone to book pickups in a few taps.' : 'Book a pickup in a few taps. No app store, no big download.';
    d.querySelector<HTMLElement>('[data-pwa-later]')!.textContent = installEvent ? 'Not now' : 'Close';
    store.mark('shown');
    d.showModal();
  };

  const isTyping = () => {
    const el = document.activeElement;
    return !!el && (el.matches('input, textarea, select') || (el as HTMLElement).isContentEditable);
  };

  const maybeAutoOpen = () => {
    if (!engaged || store.seen() || !canShow()) return;
    if (window.location.pathname.startsWith('/offline')) return;
    if (document.querySelector('dialog[open]')) return;
    if (isTyping()) {
      // Never interrupt someone filling in a field: try again shortly after they leave it.
      document.addEventListener('focusout', () => window.setTimeout(maybeAutoOpen, 1500), { once: true });
      return;
    }
    open();
  };

  const engage = () => {
    if (engaged) return;
    engaged = true;
    window.removeEventListener('scroll', onScroll);
    maybeAutoOpen();
  };
  const onScroll = () => {
    if (window.scrollY > window.innerHeight * 0.6) engage();
  };

  if (!store.seen() && !isStandalone()) {
    window.setTimeout(engage, ENGAGE_DELAY_MS);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault(); // use our own prompt instead of the browser's mini-infobar
    installEvent = e as InstallEvent;
    const d = dialog();
    if (d?.open) {
      // Upgrade an open sheet from instructions to one-tap install.
      d.close();
      open();
    }
  });

  window.addEventListener('appinstalled', () => {
    installEvent = null;
    store.mark('installed');
    close();
    syncTriggers();
  });

  const d = dialog();
  if (d) {
    d.querySelector('[data-pwa-close]')?.addEventListener('click', close);
    d.querySelector('[data-pwa-later]')?.addEventListener('click', close);
    d.addEventListener('click', (e) => {
      if (e.target === d) close();
    });
    d.querySelector('[data-pwa-install]')?.addEventListener('click', async () => {
      if (!installEvent) return;
      const ev = installEvent;
      installEvent = null;
      await ev.prompt();
      const { outcome } = await ev.userChoice;
      store.mark(outcome === 'accepted' ? 'installed' : 'dismissed');
      close();
    });
    d.querySelector('[data-pwa-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(window.location.origin + '/');
        btn.textContent = 'Link copied';
      } catch {
        btn.textContent = window.location.origin + '/';
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    syncTriggers();
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      el.addEventListener('click', open);
    });
    // Arrived from the desktop QR code or a shared install link: show the sheet straight away.
    const params = new URLSearchParams(window.location.search);
    if (params.get('install') === '1') {
      params.delete('install');
      const qs = params.toString();
      history.replaceState(history.state, '', window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash);
      window.setTimeout(open, 600);
    }
  });

  // Offline support.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    const register = () => navigator.serviceWorker.register('/sw.js').catch(() => {});
    if (document.readyState === 'complete') register();
    else window.addEventListener('load', register, { once: true });
  }
</script>
