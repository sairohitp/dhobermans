---
import Icon from './Icon.astro';
import { site } from '../config';
import { services } from '../data';
import { wa, msg } from '../lib/wa';

const year = new Date().getFullYear();
const company = [
  { href: '/#why-us', label: 'Why us' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/laundry-service-hsr-layout/', label: 'Laundry in HSR Layout' },
  { href: '/business/', label: 'For businesses' },
  { href: '/#locations', label: 'Self-laundry locations' },
  { href: '/care/', label: "Shop dhobermans' care" },
];
const help = [
  { href: '/#book', label: 'Book a pickup' },
  { href: '/#plan-finder', label: 'Plan finder' },
  { href: '/guides/stain-removal/', label: 'Stain removal guide' },
  { href: '/guides/care-labels/', label: 'Care label guide' },
  { href: '/#faq', label: 'FAQs' },
];
const socials = [
  { href: site.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.linkedin, icon: 'linkedin', label: 'LinkedIn' },
].filter((s) => s.href);
const shareText = `I use dhobermans for laundry pickup and delivery in ${site.city}. Have a look: ${site.url}`;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__wordmark">dhobermans</a>
        <p>Laundry pickup and delivery in {site.city}.</p>
        <p class="footer__contact">
          <span>Find us</span>
          <span class="footer__addr">{site.base.full}</span>
          <span>Free pickup &amp; delivery within {site.freeRadiusKm} km</span>
        </p>
        <p class="footer__contact">
          <span>WhatsApp us</span>
          <a href={wa(msg.question)} target="_blank" rel="noopener" data-flow="question">{site.whatsappDisplay}</a>
        </p>
        {
          site.email && (
            <p class="footer__contact">
              <span>Write to us</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )
        }
        <button type="button" class="share" data-share data-text={shareText} data-url={site.url}>
          <Icon name="share" size={16} /> Share with a neighbour
        </button>
      </div>

      <div class="footer__col">
        <h3>Services</h3>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer__col">
        <h3>Company</h3>
        <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div class="footer__col">
        <h3>Tools &amp; help</h3>
        <ul>
          {help.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={wa(msg.question)} target="_blank" rel="noopener" data-flow="question" data-flow-topic="track">Where is my order?</a></li>
          <li><a href={wa(msg.question)} target="_blank" rel="noopener" data-flow="business">Business quotes</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__social">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
      </div>
      <p>
        &copy; {year} dhobermans. All rights reserved. <a class="footer__legal" href="/privacy/">Privacy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 72px 32px;
    background: var(--dark);
    color: #a3a3a3;
    font-size: 15px;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid #262626;
  }

  .footer__legal {
    margin-left: 8px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__wordmark {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: var(--tracking);
  }

  .footer__brand p {
    margin-top: 14px;
    max-width: 280px;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
  }

  .footer__addr {
    color: var(--white);
    font-weight: 500;
  }

  .footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #5aa8ff;
    font-size: 17px;
    font-weight: 700;
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 20px;
    padding: 0 16px;
    border: 1px solid #333;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .share:hover {
    border-color: #666;
  }

  .footer__col h3 {
    margin-bottom: 18px;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: var(--tracking);
  }

  .footer__col ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-block;
    padding-block: 4px;
  }

  .footer__col a,
  .footer__social a {
    transition: color 0.2s ease;
  }

  .footer__col a:hover,
  .footer__social a:hover {
    color: var(--white);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    font-size: 14px;
  }

  .footer__social {
    display: flex;
    gap: 16px;
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .footer {
      /* room for the fixed mobile action bar */
      padding-bottom: calc(104px + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding-top: 56px;
    }

    .footer__top {
      gap: 32px;
    }

    .footer__bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-share]');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.text ?? '';
      const url = btn.dataset.url ?? '';
      if (navigator.share) {
        try {
          await navigator.share({ title: 'dhobermans', text, url });
          return;
        } catch {
          return; // user dismissed the share sheet
        }
      }
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  });
</script>
