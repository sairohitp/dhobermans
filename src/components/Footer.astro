---
import Icon from './Icon.astro';
import { site } from '../config';
import { services } from '../data';

const year = new Date().getFullYear();
const company = [
  { href: '/#why-us', label: 'Why us' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#locations', label: 'Self-laundry locations' },
  { href: '/care', label: "dhobermans' care" },
];
const help = [
  { href: '/#book', label: 'Schedule a pickup' },
  { href: '/#faq', label: 'FAQs' },
  { href: '/#contact', label: 'Contact' },
];
const socials = [
  { href: site.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.linkedin, icon: 'linkedin', label: 'LinkedIn' },
].filter((s) => s.href);
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__wordmark">dhobermans</a>
        <p>Laundry pickup and delivery in {site.city}.</p>
        {
          site.email && (
            <p class="footer__contact">
              <span>Write to us</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )
        }
        {
          site.phone && (
            <p class="footer__contact">
              <span>Call us</span>
              <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>
            </p>
          )
        }
      </div>

      <div class="footer__col">
        <h3>Services</h3>
        <ul>{services.map((s) => <li><a href={`/?service=${s.slug}#book`}>{s.name}</a></li>)}</ul>
      </div>
      <div class="footer__col">
        <h3>Company</h3>
        <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div class="footer__col">
        <h3>Help</h3>
        <ul>{help.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__social">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
      </div>
      <p>&copy; {year} dhobermans. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 72px 32px;
    background: var(--dark);
    color: #a3a3a3;
    font-size: 15px;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid #262626;
  }

  .footer__wordmark {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .footer__brand p {
    margin-top: 14px;
    max-width: 280px;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
  }

  .footer__contact a {
    color: #5aa8ff;
    font-size: 17px;
    font-weight: 700;
  }

  .footer__col h3 {
    margin-bottom: 18px;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a,
  .footer__social a {
    transition: color 0.2s ease;
  }

  .footer__col a:hover,
  .footer__social a:hover {
    color: var(--white);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    font-size: 14px;
  }

  .footer__social {
    display: flex;
    gap: 16px;
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
