---
import Icon from './Icon.astro';
import { wa } from '../lib/wa';
---

<a class="wa-fab" href={wa()} target="_blank" rel="noopener" aria-label="Book a pickup on WhatsApp" data-flow="pickup">
  <Icon name="whatsapp" size={28} />
  <span class="wa-fab__tip">Book a pickup</span>
</a>

<div class="dock" aria-label="Quick actions">
  <a class="dock__secondary" href="/#pricing">Pricing</a>
  <a class="dock__primary" href={wa()} target="_blank" rel="noopener" data-flow="pickup">
    <Icon name="whatsapp" size={20} />
    Book a pickup
  </a>
</div>

<style>
  .wa-fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25d366;
    color: var(--white);
    box-shadow: 0 12px 28px -8px rgba(37, 211, 102, 0.7);
    transition: transform 0.2s ease;
  }

  .wa-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    opacity: 0.5;
    animation: pulse 2.4s ease-out infinite;
    z-index: -1;
  }

  .wa-fab:hover {
    transform: scale(1.06);
  }

  .wa-fab__tip {
    position: absolute;
    right: 72px;
    padding: 8px 14px;
    border-radius: var(--radius-btn);
    background: var(--ink);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: all 0.2s ease;
    pointer-events: none;
  }

  .wa-fab:hover .wa-fab__tip,
  .wa-fab:focus-visible .wa-fab__tip {
    opacity: 1;
    transform: none;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .dock {
    display: none;
  }

  @media (max-width: 720px) {
    .wa-fab {
      display: none;
    }

    .dock {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 45;
      display: flex;
      gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 -8px 24px -12px rgba(16, 24, 40, 0.2);
    }

    .dock a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 50px;
      border-radius: var(--radius-btn);
      font-size: 16px;
      font-weight: 700;
    }

    .dock__secondary {
      flex: none;
      padding: 0 18px;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--ink);
    }

    .dock__primary {
      flex: 1;
      background: var(--wa);
      color: var(--white);
    }
  }
</style>
