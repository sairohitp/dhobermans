---
import Icon from './Icon.astro';
import { wa, msg } from '../lib/wa';

import { careGroups as groups, careSvgAttrs as svgAttrs } from '../lib/careSymbols';

const first = groups[0].symbols[0];
---

<div class="labels" data-labels>
  <div class="labels__detail" aria-live="polite">
    <span class="labels__tile" data-label-art set:html={`<svg ${svgAttrs}>${first.svg}</svg>`} />
    <div>
      <h3 data-label-title>{first.title}</h3>
      <p data-label-text>{first.text}</p>
    </div>
  </div>

  <div class="labels__groups">
    {
      groups.map((g) => (
        <div class="lg">
          <span class="lg__name">{g.name}</span>
          <div class="lg__row">
            {g.symbols.map((sym) => (
              <button
                type="button"
                class="sym"
                aria-pressed={sym.id === first.id ? 'true' : 'false'}
                aria-label={sym.title}
                data-title={sym.title}
                data-text={sym.text}
                set:html={`<svg ${svgAttrs}>${sym.svg}</svg>`}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <p class="labels__note">
    Symbols follow the international care-labelling standard (ISO 3758). Some labels use slightly different drawings.{' '}
    <a href={wa(msg.question)} target="_blank" rel="noopener" data-flow="question" data-flow-topic="label">
      <Icon name="whatsapp" size={14} /> Not sure? Send us a photo of the label
    </a>
  </p>
</div>

<style>
  .labels {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 24px 32px;
    align-items: start;
    max-width: 900px;
    margin-inline: auto;
    padding: clamp(16px, 3vw, 32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }

  .labels__detail {
    position: sticky;
    top: calc(var(--header-h) + 20px);
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .labels__tile {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink);
  }

  .labels__tile :global(svg) {
    width: 84px;
    height: 84px;
  }

  .labels__detail h3 {
    color: var(--white);
    font-size: 24px;
  }

  .labels__detail p {
    margin-top: 8px;
    color: rgba(255, 255, 255, 0.8);
  }

  .labels__groups {
    display: grid;
    gap: 16px;
  }

  .lg {
    display: grid;
    gap: 8px;
  }

  .lg__name {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-weight: 500;
  }

  .lg__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sym {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .sym :global(svg) {
    width: 34px;
    height: 34px;
  }

  .sym:hover {
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  .sym[aria-pressed='true'] {
    border-color: var(--white);
    background: var(--white);
    color: var(--ink);
  }

  .labels__note {
    grid-column: 1 / -1;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    text-align: center;
  }

  .labels__note a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    margin-left: 6px;
    color: #7fd6a4;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .labels {
      grid-template-columns: 1fr;
    }

    .labels__detail {
      position: static;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 14px;
      min-height: 96px;
    }

    .labels__tile {
      width: 84px;
      height: 84px;
    }

    .labels__tile :global(svg) {
      width: 54px;
      height: 54px;
    }

    .labels__detail h3 {
      font-size: 19px;
    }

    .labels__detail p {
      margin-top: 4px;
      font-size: 15px;
    }

    .sym {
      width: 52px;
      height: 52px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-labels]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.sym')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        root.querySelector('[data-label-title]')!.textContent = b.dataset.title ?? '';
        root.querySelector('[data-label-text]')!.textContent = b.dataset.text ?? '';
        root.querySelector('[data-label-art]')!.innerHTML = b.innerHTML;
      }),
    );
  });
</script>
