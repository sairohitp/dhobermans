---
import OrderWizard from './OrderWizard.astro';
---

<dialog class="flow" data-flow-sheet aria-labelledby="wz-title" transition:persist="booking-flow">
  <OrderWizard mode="sheet" />
</dialog>

<style>
  .flow {
    width: min(680px, calc(100% - 48px));
    height: min(860px, calc(100dvh - 48px));
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: 0 40px 100px -30px rgba(0, 31, 77, 0.45);
  }

  .flow::backdrop {
    background: rgba(10, 14, 22, 0.38);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
  }

  .flow[open] {
    display: flex;
    animation: flow-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes flow-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .flow {
      width: 100%;
      height: 100dvh;
      margin: 0;
      border-radius: 0;
    }

    .flow[open] {
      animation-name: flow-up;
    }

    @keyframes flow-up {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
