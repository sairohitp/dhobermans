---
import Icon from './Icon.astro';
import { services } from '../data';
import { planOptions } from '../lib/booking';
---

<dialog class="flow" data-flow-sheet aria-labelledby="flow-title" transition:persist="booking-flow">
  <div class="flow__panel">
    <header class="flow__head">
      <button type="button" class="flow__icon" data-flow-back aria-label="Back"><Icon name="arrow-left" size={20} /></button>
      <div class="flow__titles">
        <h2 id="flow-title" data-flow-title>Book a pickup</h2>
        <p data-flow-count>Step 1 of 3</p>
      </div>
      <button type="button" class="flow__icon" data-flow-close aria-label="Close"><Icon name="x" size={20} /></button>
    </header>
    <div class="flow__bar" aria-hidden="true"><div data-flow-progress></div></div>

    <div class="flow__body">
      <!-- What and when -->
      <section class="flow__step" data-panel="what" hidden>
        <fieldset class="group">
          <legend>What needs care?</legend>
          <div class="chips">
            {
              services.map((s) => (
                <label class="chip">
                  <input type="checkbox" name="flow-svc" value={s.name} />
                  <span>{s.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>Preferred pickup slot</legend>
          <div class="chips" data-flow-slots></div>
        </fieldset>
        <label class="group">
          <span class="label">Plan</span>
          <select class="input" data-ff="plan">
            {planOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </label>
      </section>

      <!-- Where and who -->
      <section class="flow__step" data-panel="where" hidden>
        <div class="items" data-flow-items hidden></div>
        <label class="group">
          <span class="label">Your name</span>
          <input class="input" type="text" autocomplete="name" data-ff="name" />
        </label>
        <label class="group">
          <span class="label">Pincode</span>
          <input class="input" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="6-digit pincode" data-ff="pincode" />
          <small class="pin" data-flow-pin aria-live="polite">We serve all of Bangalore.</small>
        </label>
        <label class="group">
          <span class="label" data-address-label>Pickup address</span>
          <textarea class="input" rows="2" autocomplete="street-address" placeholder="Flat, building, street, area" data-ff="address"></textarea>
        </label>
        <label class="group">
          <span class="label">Notes <em>(optional)</em></span>
          <input class="input" type="text" placeholder="Gate code, delicate items..." data-ff="notes" />
        </label>
      </section>

      <!-- Question -->
      <section class="flow__step" data-panel="ask" hidden>
        <label class="group">
          <span class="label">Your name</span>
          <input class="input" type="text" autocomplete="name" data-ff="name2" />
        </label>
        <label class="group">
          <span class="label">Your question</span>
          <textarea class="input" rows="4" placeholder="How can we help?" data-ff="question"></textarea>
        </label>
      </section>

      <!-- Notify -->
      <section class="flow__step" data-panel="notify" hidden>
        <p class="flow__lead" data-flow-location></p>
        <label class="group">
          <span class="label">Your name</span>
          <input class="input" type="text" autocomplete="name" data-ff="name3" />
        </label>
        <label class="group">
          <span class="label">Pincode <em>(optional)</em></span>
          <input class="input" type="text" inputmode="numeric" autocomplete="postal-code" data-ff="pincode3" />
        </label>
      </section>

      <!-- Preview -->
      <section class="flow__step" data-panel="preview" hidden>
        <p class="flow__lead">This is the message we'll send for you. WhatsApp opens with it ready; just tap send.</p>
        <div class="chat">
          <div class="chat__head">
            <span class="chat__avatar"><Icon name="whatsapp" size={16} /></span>
            <span><strong>dhobermans</strong><small>WhatsApp</small></span>
          </div>
          <div class="chat__body"><p class="bubble" data-flow-preview></p></div>
        </div>
        <button type="button" class="flow__edit" data-flow-edit>Edit details</button>
      </section>

      <!-- Done -->
      <section class="flow__step flow__done" data-panel="done" hidden>
        <span class="flow__ok"><Icon name="check" size={28} /></span>
        <h3>Finish in WhatsApp</h3>
        <p>Your message is ready in WhatsApp. Tap <strong>send</strong> there and we'll reply shortly.</p>
        <button type="button" class="btn btn--ghost btn--block" data-flow-clearcart hidden>Clear my cart</button>
      </section>
    </div>

    <footer class="flow__foot">
      <p class="flow__hint" data-flow-hint aria-live="polite"></p>
      <button type="button" class="btn btn--primary btn--block" data-flow-next>Continue</button>
      <a class="btn btn--wa btn--block" href="#" target="_blank" rel="noopener" data-flow-send hidden>
        <Icon name="whatsapp" size={20} /> Open WhatsApp
      </a>
      <button type="button" class="btn btn--primary btn--block" data-flow-close hidden data-flow-finish>Done</button>
    </footer>
  </div>
</dialog>

<style>
  .flow {
    width: calc(100% - 32px);
    max-width: 520px;
    max-height: min(760px, calc(100dvh - 48px));
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .flow::backdrop {
    background: rgba(12, 12, 12, 0.5);
  }

  .flow[open] {
    display: flex;
    animation: flow-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes flow-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .flow__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .flow__head {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 8px;
    padding: 14px 14px 10px;
  }

  .flow__titles {
    text-align: center;
  }

  .flow__titles h2 {
    font-size: 18px;
  }

  .flow__titles p {
    color: var(--subtle);
    font-size: 13px;
  }

  .flow__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
  }

  .flow__icon[data-hidden] {
    visibility: hidden;
  }

  .flow__bar {
    height: 3px;
    margin: 0 20px;
    border-radius: 3px;
    background: var(--surface-2);
  }

  .flow__bar div {
    width: 33%;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
    transition: width 0.3s ease;
  }

  .flow__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 20px;
  }

  .flow__step {
    display: grid;
    gap: 18px;
  }

  .group {
    display: grid;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .group legend,
  .label {
    padding: 0;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .group legend {
    margin-bottom: 8px;
  }

  .label em {
    color: var(--subtle);
    font-style: normal;
    font-weight: 500;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips :global(.chip) {
    position: relative;
    cursor: pointer;
  }

  .chips :global(.chip input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chips :global(.chip span) {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 15px;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .chips :global(.chip input:checked + span) {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--white);
  }

  .chips :global(.chip input:focus-visible + span) {
    box-shadow: 0 0 0 3px var(--brand-100);
  }

  .pin {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
  }

  .pin.is-ok {
    color: #0f7b46;
  }

  .pin.is-maybe {
    color: #a15c00;
  }

  .items {
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 14px;
    white-space: pre-line;
  }

  .flow__lead {
    color: var(--muted);
    font-size: 15px;
  }

  .chat {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: #075e54;
    color: var(--white);
  }

  .chat__head span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .chat__head small {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  }

  .chat__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--wa);
  }

  .chat__body {
    min-height: 160px;
    padding: 16px 14px;
    background:
      radial-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px) 0 0 / 12px 12px,
      #efeae2;
  }

  .bubble {
    margin-left: auto;
    max-width: 92%;
    padding: 10px 12px;
    border-radius: 8px 2px 8px 8px;
    background: #d9fdd3;
    color: #111b21;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-line;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }

  .flow__edit {
    justify-self: center;
    min-height: 40px;
    padding: 0 8px;
    border: 0;
    background: none;
    color: var(--brand);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .flow__done {
    justify-items: center;
    padding: 24px 0;
    text-align: center;
  }

  .flow__done h3 {
    font-size: 22px;
  }

  .flow__done p {
    max-width: 340px;
    color: var(--muted);
  }

  .flow__ok {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--wa);
    color: var(--white);
  }

  .flow__foot {
    display: grid;
    gap: 8px;
    padding: 12px 20px calc(16px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }

  .flow__hint {
    color: #c62828;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }

  .flow__hint:empty {
    display: none;
  }

  @media (max-width: 720px) {
    .flow {
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border-radius: 0;
    }

    .flow__head {
      padding-top: calc(12px + env(safe-area-inset-top));
    }
  }
</style>

<script>
  import { compose, waLink, type Intent, type FlowData } from '../lib/booking';
  import { nextSlots, pincodeStatus, type Slot } from '../lib/slots';
  import { cart, profile, rupees } from '../lib/store';
  import { products, packPrice } from '../data';
  import { site } from '../config';

  type Panel = 'what' | 'where' | 'ask' | 'notify' | 'preview' | 'done';

  const STEPS: Record<Intent, Panel[]> = {
    pickup: ['what', 'where', 'preview'],
    service: ['what', 'where', 'preview'],
    plan: ['what', 'where', 'preview'],
    stain: ['what', 'where', 'preview'],
    question: ['ask', 'preview'],
    location: ['notify', 'preview'],
    order: ['where', 'preview'],
  };

  const TITLES: Record<Intent, string> = {
    pickup: 'Book a pickup',
    service: 'Book a pickup',
    plan: 'Start your plan',
    stain: 'Stain removal',
    question: 'Ask us anything',
    location: 'Get notified',
    order: 'Your order',
  };

  let intent: Intent = 'pickup';
  let steps: Panel[] = STEPS.pickup;
  let index = 0;
  let slots: Slot[] = [];
  let location = '';

  const sheet = () => document.querySelector<HTMLDialogElement>('[data-flow-sheet]')!;
  const q = <T extends Element = HTMLElement>(sel: string) => sheet().querySelector<T>(sel)!;
  const val = (f: string) => (q<HTMLInputElement>(`[data-ff="${f}"]`).value || '').trim();
  const setVal = (f: string, v = '') => (q<HTMLInputElement>(`[data-ff="${f}"]`).value = v);

  const chosenServices = () => [...sheet().querySelectorAll<HTMLInputElement>('input[name="flow-svc"]:checked')].map((i) => i.value);
  const chosenSlot = () => slots.find((s) => s.id === sheet().querySelector<HTMLInputElement>('input[name="flow-slot"]:checked')?.value);

  const orderLines = () =>
    cart.lines().map((l) => {
      const p = products.find((x) => x.slug === l.slug)!;
      return `• ${l.qty} × ${p.name} (${p.size}) = ${rupees(l.qty * p.amount)}`;
    });

  const data = (): FlowData => {
    const base: FlowData = { intent };
    if (intent === 'question') return { ...base, name: val('name2'), question: val('question') };
    if (intent === 'location') return { ...base, name: val('name3'), pincode: val('pincode3'), location };
    const contact = { name: val('name'), pincode: val('pincode'), address: val('address'), notes: val('notes') };
    if (intent === 'order') return { ...base, ...contact, items: orderLines(), total: rupees(cart.total()) };
    return { ...base, ...contact, services: chosenServices(), slot: chosenSlot()?.long, plan: val('plan') };
  };

  const problem = (panel: Panel): string => {
    if (panel === 'what') {
      if (!chosenServices().length) return 'Choose at least one service.';
      if (!chosenSlot()) return 'Choose a pickup slot.';
    }
    if (panel === 'where') {
      if (val('name').length < 2) return 'Enter your name.';
      if (!/^\d{6}$/.test(val('pincode'))) return 'Enter your 6-digit pincode.';
      if (val('address').length < 8) return intent === 'order' ? 'Enter your delivery address.' : 'Enter your pickup address.';
    }
    if (panel === 'ask') {
      if (val('name2').length < 2) return 'Enter your name.';
      if (val('question').length < 3) return 'Type your question.';
    }
    if (panel === 'notify' && val('name3').length < 2) return 'Enter your name.';
    return '';
  };

  const render = () => {
    const panel = steps[index];
    sheet().querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => (el.hidden = el.dataset.panel !== panel));
    const done = panel === 'done';
    const total = steps.length - 1; // the confirmation screen is not a step
    q('[data-flow-count]').textContent = done ? 'Sent to WhatsApp' : panel === 'preview' ? `Preview · step ${total} of ${total}` : `Step ${index + 1} of ${total}`;
    q<HTMLElement>('[data-flow-progress]').style.width = done ? '100%' : `${((index + 1) / total) * 100}%`;
    q('[data-flow-back]').toggleAttribute('data-hidden', index === 0 || done);
    q('[data-flow-hint]').textContent = '';
    q('[data-flow-next]').hidden = panel === 'preview' || done;
    q('[data-flow-send]').hidden = panel !== 'preview';
    q('[data-flow-finish]').hidden = !done;
    q('[data-flow-clearcart]').hidden = !(done && intent === 'order' && cart.count() > 0);
    if (panel === 'preview') {
      const text = compose(data());
      q('[data-flow-preview]').textContent = text;
      q<HTMLAnchorElement>('[data-flow-send]').href = waLink(site.whatsapp, text);
    }
    q('.flow__body').scrollTop = 0;
  };

  const go = (i: number) => {
    index = Math.max(0, Math.min(i, steps.length - 1));
    render();
  };

  const next = () => {
    const issue = problem(steps[index]);
    if (issue) {
      q('[data-flow-hint]').textContent = issue;
      return;
    }
    go(index + 1);
  };

  const updatePin = () => {
    const input = q<HTMLInputElement>('[data-ff="pincode"]');
    input.value = input.value.replace(/\D/g, '').slice(0, 6);
    const st = pincodeStatus(input.value);
    const el = q('[data-flow-pin]');
    el.textContent = st.text;
    el.className = `pin ${st.cls}`;
  };

  type OpenOptions = { intent?: Intent; service?: string; plan?: string; location?: string; notes?: string };

  const open = (opts: OpenOptions = {}) => {
    const d = sheet();
    intent = opts.intent ?? 'pickup';
    steps = [...STEPS[intent], 'done'];
    index = 0;
    location = opts.location ?? '';

    // Fresh slots every time the sheet opens.
    slots = nextSlots(4);
    q('[data-flow-slots]').innerHTML = slots
      .map((s) => `<label class="chip"><input type="radio" name="flow-slot" value="${s.id}" /><span>${s.label}</span></label>`)
      .join('');

    // Context
    sheet().querySelectorAll<HTMLInputElement>('input[name="flow-svc"]').forEach((i) => {
      i.checked = !!opts.service && i.value === opts.service;
    });
    if (intent === 'plan' || intent === 'pickup') {
      const wf = sheet().querySelector<HTMLInputElement>('input[name="flow-svc"][value="Wash & Fold"]');
      if (wf && intent === 'plan') wf.checked = true;
    }
    const planSelect = q<HTMLSelectElement>('[data-ff="plan"]');
    const wanted = opts.plan ?? 'payg';
    if (![...planSelect.options].some((o) => o.value === wanted) && /^monthly-\d+$/.test(wanted)) {
      // A pack size from the estimator that isn't in the standard list.
      const kg = Number(wanted.split('-')[1]);
      planSelect.add(new Option(`Monthly pack · ${kg} kg · ${rupees(packPrice(kg))}/month`, wanted), 1);
    }
    planSelect.value = wanted;
    if (planSelect.selectedIndex < 0) planSelect.value = 'payg';
    setVal('notes', opts.notes ?? '');
    setVal('question', '');
    q('[data-flow-location]').textContent = location ? `We'll message you on WhatsApp when the ${location} spot opens.` : '';
    q('[data-address-label]').textContent = intent === 'order' ? 'Delivery address' : 'Pickup address';
    const items = q('[data-flow-items]');
    items.hidden = intent !== 'order';
    if (intent === 'order') items.textContent = `${orderLines().join('\n')}\nTotal: ${rupees(cart.total())}`;
    q('[data-flow-title]').textContent = TITLES[intent];

    // Saved details make repeat bookings quick.
    const saved = profile.get();
    for (const [f, v] of [
      ['name', saved.name],
      ['name2', saved.name],
      ['name3', saved.name],
      ['pincode', saved.pincode],
      ['pincode3', saved.pincode],
      ['address', saved.address],
    ] as const) {
      if (!val(f) && v) setVal(f, v);
    }
    updatePin();
    render();
    if (!d.open) d.showModal();
  };

  const close = () => {
    const d = sheet();
    if (d.open) d.close();
  };

  // Every WhatsApp touchpoint opens the flow first (the plain wa.me link still works without JavaScript).
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-flow]');
    if (!t) return;
    e.preventDefault();
    const ds = t.dataset;
    open({ intent: (ds.flow as Intent) || 'pickup', service: ds.flowService, plan: ds.flowPlan, location: ds.flowLocation, notes: ds.flowNotes });
  });
  document.addEventListener('dhb:flow', (e) => open((e as CustomEvent<OpenOptions>).detail));

  const d = sheet();
  d.querySelector('[data-flow-next]')!.addEventListener('click', next);
  d.querySelector('[data-flow-back]')!.addEventListener('click', () => go(index - 1));
  d.querySelector('[data-flow-edit]')!.addEventListener('click', () => go(0));
  d.querySelectorAll('[data-flow-close]').forEach((b) => b.addEventListener('click', close));
  d.addEventListener('click', (e) => {
    if (e.target === d) close();
  });
  d.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).matches('[data-ff="pincode"]')) updatePin();
    q('[data-flow-hint]').textContent = '';
  });
  d.addEventListener('change', () => (q('[data-flow-hint]').textContent = ''));
  d.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).matches('input')) {
      e.preventDefault();
      next();
    }
  });
  d.querySelector('[data-flow-send]')!.addEventListener('click', () => {
    const f = data();
    profile.save({ ...profile.get(), name: f.name, pincode: f.pincode || profile.get().pincode, address: f.address || profile.get().address });
    window.setTimeout(() => go(steps.length - 1), 300);
  });
  d.querySelector('[data-flow-clearcart]')!.addEventListener('click', () => {
    cart.clear();
    close();
  });
</script>
