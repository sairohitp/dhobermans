---
import { site } from '../config';
import { services, plans, slots } from '../data';
---

<form
  class="form"
  data-booking-form
  data-endpoint={site.formEndpoint}
  data-whatsapp={site.whatsapp}
  data-email={site.email}
  novalidate
>
  <div class="form__grid">
    <label class="field">
      <span>Full name</span>
      <input name="name" type="text" autocomplete="name" required placeholder="Your name" />
    </label>
    <label class="field">
      <span>Phone</span>
      <input
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
        pattern="^(\+?91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}$"
        placeholder="10-digit mobile number"
      />
    </label>
    <label class="field field--full">
      <span>Pickup address</span>
      <textarea name="address" rows="2" autocomplete="street-address" required placeholder="Flat, building, street, area"
      ></textarea>
    </label>
    <label class="field">
      <span>Pickup date</span>
      <input name="date" type="date" required data-min-today />
    </label>
    <label class="field">
      <span>Time slot</span>
      <select name="slot" required>
        <option value="" disabled selected>Select a slot</option>
        {slots.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>

    <fieldset class="field field--full">
      <legend>What needs care?</legend>
      <div class="pills">
        {
          services.map((s) => (
            <label class="pill">
              <input type="checkbox" name="services" value={s.name} data-service={s.slug} />
              <span>{s.name}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="field">
      <span>Plan</span>
      <select name="plan" data-plan-select>
        <option value="Not sure yet">Not sure yet</option>
        {plans.map((p) => <option value={p.name} data-plan={p.id}>{p.name} ({p.price}/month)</option>)}
      </select>
    </label>
    <label class="field">
      <span>Email <em>(optional)</em></span>
      <input name="email" type="email" autocomplete="email" placeholder="you@example.com" />
    </label>
    <label class="field field--full">
      <span>Notes <em>(optional)</em></span>
      <textarea name="notes" rows="3" placeholder="Anything we should know? Questions are welcome too." data-notes
      ></textarea>
    </label>
  </div>

  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />

  <button type="submit" class="btn btn--primary btn--block form__submit">Request pickup</button>
  <p class="form__status" role="status" aria-live="polite" data-form-status></p>
</form>

<style>
  .form {
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field > span,
  .field legend {
    padding: 0;
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
  }

  .field legend {
    margin-bottom: 8px;
  }

  .field em {
    color: var(--subtle);
    font-style: normal;
    font-weight: 500;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--brand);
    background: var(--white);
    box-shadow: 0 0 0 4px var(--brand-100);
    outline: none;
  }

  .form.was-validated :invalid:not(fieldset) {
    border-color: #e5484d;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    position: relative;
    cursor: pointer;
  }

  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pill span {
    display: inline-block;
    padding: 9px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .pill input:checked + span {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--white);
  }

  .pill input:focus-visible + span {
    box-shadow: 0 0 0 4px var(--brand-100);
  }

  .form__submit {
    margin-top: 22px;
  }

  .form__status {
    margin-top: 12px;
    min-height: 1.5em;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }

  .form__status.is-success {
    color: #0f7b46;
  }

  .form__status.is-error {
    color: #c62828;
  }

  @media (max-width: 560px) {
    .form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const { endpoint, whatsapp, email } = form.dataset;

    // Earliest pickup date is today (local time).
    const dateInput = form.querySelector<HTMLInputElement>('[data-min-today]');
    if (dateInput) {
      const d = new Date();
      const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      dateInput.min = local;
    }

    // Preselect from links such as /?service=dry-cleaning#book, ?plan=premium, ?product=...
    const applyParams = (params: URLSearchParams) => {
      const service = params.get('service');
      const plan = params.get('plan');
      const product = params.get('product');
      if (service) {
        const box = form.querySelector<HTMLInputElement>(`[data-service="${CSS.escape(service)}"]`);
        if (box) box.checked = true;
      }
      if (plan) {
        const opt = form.querySelector<HTMLOptionElement>(`[data-plan="${CSS.escape(plan)}"]`);
        if (opt) opt.selected = true;
      }
      if (product) {
        const notes = form.querySelector<HTMLTextAreaElement>('[data-notes]');
        if (notes && !notes.value) notes.value = `I'd like to order: ${product}`;
      }
    };
    applyParams(new URLSearchParams(window.location.search));

    // Same-page links preselect the form and scroll to it without a reload.
    const bookSection = document.getElementById('book');
    document.querySelectorAll<HTMLAnchorElement>('a[href*="#book"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const url = new URL(a.href, window.location.href);
        if (url.pathname !== window.location.pathname || !bookSection) return;
        e.preventDefault();
        applyParams(url.searchParams);
        bookSection.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', '#book');
      });
    });

    const setStatus = (msg: string, kind: 'success' | 'error' | '' = '') => {
      status.textContent = msg;
      status.className = `form__status${kind ? ` is-${kind}` : ''}`;
    };

    const summary = (data: FormData) => {
      const svc = data.getAll('services').join(', ') || 'Not specified';
      return [
        'New pickup request (dhobermans.com)',
        `Name: ${data.get('name')}`,
        `Phone: ${data.get('phone')}`,
        `Address: ${data.get('address')}`,
        `Date: ${data.get('date')}  Slot: ${data.get('slot')}`,
        `Services: ${svc}`,
        `Plan: ${data.get('plan')}`,
        data.get('email') ? `Email: ${data.get('email')}` : '',
        data.get('notes') ? `Notes: ${data.get('notes')}` : '',
      ]
        .filter(Boolean)
        .join('\n');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('was-validated');
      if (!form.checkValidity()) {
        const first = form.querySelector<HTMLElement>(':invalid:not(fieldset)');
        first?.focus();
        setStatus('Please complete the highlighted fields.', 'error');
        return;
      }

      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      if (endpoint) {
        submit.disabled = true;
        setStatus('Sending your request...');
        try {
          data.append('_subject', 'New pickup request');
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          form.classList.remove('was-validated');
          setStatus("Thank you. We've received your request and will confirm your pickup shortly.", 'success');
        } catch {
          setStatus('Something went wrong. Please try again in a moment.', 'error');
        } finally {
          submit.disabled = false;
        }
        return;
      }

      const text = summary(data);
      if (whatsapp) {
        window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
        setStatus('Opening WhatsApp to send your request...', 'success');
      } else if (email) {
        window.location.href = `mailto:${email}?subject=${encodeURIComponent('Pickup request')}&body=${encodeURIComponent(text)}`;
        setStatus('Opening your email app to send your request...', 'success');
      } else {
        setStatus('Online booking is being set up. Please check back soon.', 'error');
        console.warn('dhobermans: set formEndpoint, whatsapp or email in src/config.ts to receive bookings.');
      }
    });
  }
</script>
