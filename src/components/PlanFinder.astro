---
import Icon from './Icon.astro';
import { finderItems, finderPresets } from '../data';
import { wa } from '../lib/wa';
---

<div class="finder" id="plan-finder" data-finder>
  <div class="finder__inputs">
    <div class="finder__head">
      <span class="finder__badge"><Icon name="scale" size={18} /></span>
      <div>
        <h3>How much would you pay?</h3>
        <p>Tell us what you wash in a typical week. We'll estimate the weight and your monthly cost.</p>
      </div>
    </div>

    <div class="presets" role="group" aria-label="Quick presets">
      {finderPresets.map((p) => <button type="button" class="preset" data-preset={p.id}>{p.label}</button>)}
    </div>

    <ul class="items">
      {
        finderItems.map((it) => (
          <li class="item">
            <div class="item__text">
              <span class="item__label" id={`fi-${it.id}`}>{it.label}</span>
              <span class="item__hint">{it.hint}</span>
            </div>
            <div class="stepper" role="group" aria-labelledby={`fi-${it.id}`}>
              <button type="button" aria-label={`Fewer ${it.label}`} data-dec={it.id}>
                <Icon name="minus" size={16} />
              </button>
              <output data-count={it.id} data-kg={it.kg} aria-live="polite">0</output>
              <button type="button" aria-label={`More ${it.label}`} data-inc={it.id}>
                <Icon name="plus" size={16} />
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="finder__result">
    <span class="finder__label">Your estimate</span>
    <p class="finder__kg"><span data-kg-total>0.0</span> kg<small>/week</small></p>
    <p class="finder__month">About <strong data-kg-month>0</strong> kg a month</p>
    <div class="finder__rows">
      <div class="finder__row">
        <span>Pay per pickup</span>
        <strong data-cost-payg>₹0</strong>
      </div>
      <div class="finder__row finder__row--best">
        <span>Monthly pack <em data-finder-save>save ₹0</em></span>
        <strong data-cost-pack>₹0</strong>
      </div>
      <div class="finder__row" data-biz-row hidden>
        <span>Business volume rate <em data-biz-note></em></span>
        <strong data-cost-biz>₹0</strong>
      </div>
    </div>
    <a class="btn btn--white btn--block" href={wa()} target="_blank" rel="noopener" data-plan-cta data-flow="plan" data-flow-plan="monthly-40">
      Start a monthly pack
    </a>
    <p class="finder__note">Estimate based on typical dry weights at ₹100/kg, or ₹90/kg with a monthly pack. Actual loads vary.</p>
  </div>
</div>

<style>
  .finder {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    overflow: hidden;
    margin: 32px auto 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .finder__inputs {
    padding: clamp(20px, 3vw, 32px);
  }

  .finder__head {
    display: flex;
    gap: 14px;
  }

  .finder__badge {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: var(--brand-50);
    color: var(--brand);
  }

  .finder__head h3 {
    font-size: 22px;
  }

  .finder__head p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 8px;
  }

  .preset {
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: var(--surface);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset:hover,
  .preset.is-active {
    border-color: var(--brand);
    background: var(--brand-50);
    color: var(--brand-700);
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .item:last-child {
    border-bottom: 0;
  }

  .item__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .item__label {
    color: var(--ink);
    font-weight: 700;
  }

  .item__hint {
    color: var(--subtle);
    font-size: 13px;
  }

  .stepper {
    display: flex;
    flex: none;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: var(--surface);
  }

  .stepper button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .stepper button:hover {
    color: var(--brand);
  }

  .stepper output {
    min-width: 32px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    text-align: center;
  }

  .finder__result {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 3vw, 32px);
    background: linear-gradient(160deg, var(--brand) 0%, var(--brand-700) 100%);
    color: rgba(255, 255, 255, 0.85);
  }

  .finder__label {
    font-size: 15px;
    font-weight: 600;
  }

  .finder__kg {
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: var(--tracking);
    line-height: 1;
  }

  .finder__kg small {
    margin-left: 4px;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-body);
    font-size: 16px;
    letter-spacing: var(--tracking);
  }

  .finder__month {
    margin-top: -6px;
    color: rgba(255, 255, 255, 0.8);
  }

  .finder__month strong {
    color: var(--white);
  }

  .finder__rows {
    display: grid;
    gap: 8px;
  }

  .finder__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.1);
  }

  .finder__row strong {
    color: var(--white);
    font-size: 20px;
  }

  .finder__row--best {
    background: rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
  }

  .finder__row em {
    display: block;
    color: var(--white);
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
  }

  .finder__note {
    margin-top: auto;
    color: rgba(255, 255, 255, 0.65);
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .finder {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { finderPresets, packPrice, fullPrice, businessRate } from '../data';
  import { rupees } from '../lib/store';

  const WEEKS_PER_MONTH = 52 / 12;

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-finder]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const outputs = [...root.querySelectorAll<HTMLOutputElement>('[data-count]')];
    const total = root.querySelector<HTMLElement>('[data-kg-total]')!;
    const month = root.querySelector<HTMLElement>('[data-kg-month]')!;
    const payg = root.querySelector<HTMLElement>('[data-cost-payg]')!;
    const pack = root.querySelector<HTMLElement>('[data-cost-pack]')!;
    const save = root.querySelector<HTMLElement>('[data-finder-save]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-plan-cta]')!;
    const presetBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];

    const counts: Record<string, number> = {};

    const render = () => {
      let kg = 0;
      outputs.forEach((o) => {
        const id = o.dataset.count!;
        o.value = String(counts[id] ?? 0);
        o.textContent = o.value;
        kg += (counts[id] ?? 0) * Number(o.dataset.kg);
      });
      total.textContent = kg.toFixed(1);
      // Monthly estimate, rounded up to the nearest 5 kg (minimum 10 kg).
      const monthly = Math.max(10, Math.ceil((kg * WEEKS_PER_MONTH) / 5) * 5);
      month.textContent = String(monthly);
      payg.textContent = `${rupees(fullPrice(monthly))}/month`;
      pack.textContent = `${rupees(packPrice(monthly))}/month`;
      save.textContent = `save ${rupees(fullPrice(monthly) - packPrice(monthly))}`;
      cta.dataset.flowPlan = `monthly-${monthly}`;
      const biz = businessRate(monthly);
      const bizRow = root.querySelector<HTMLElement>('[data-biz-row]')!;
      bizRow.hidden = biz === null;
      if (biz !== null) {
        root.querySelector('[data-cost-biz]')!.textContent = `${rupees(monthly * biz)}/month`;
        root.querySelector('[data-biz-note]')!.textContent = `${rupees(biz)}/kg at 100 kg+`;
      }
    };

    const applyPreset = (id: string) => {
      const p = finderPresets.find((x) => x.id === id);
      if (!p) return;
      Object.assign(counts, p.counts);
      presetBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.preset === id));
      render();
    };

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('button');
      if (!t) return;
      if (t.dataset.preset) return applyPreset(t.dataset.preset);
      const inc = t.dataset.inc;
      const dec = t.dataset.dec;
      if (inc) counts[inc] = Math.min(99, (counts[inc] ?? 0) + 1);
      if (dec) counts[dec] = Math.max(0, (counts[dec] ?? 0) - 1);
      if (inc || dec) {
        presetBtns.forEach((b) => b.classList.remove('is-active'));
        render();
      }
    });

    applyPreset('couple');
  };

  document.addEventListener('astro:page-load', init);
</script>
