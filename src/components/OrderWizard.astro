---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data';
import { planOptions, LOAD_SIZES, LOAD_MAX } from '../lib/booking';
import { wa, msg } from '../lib/wa';
import { site } from '../config';

interface Props {
  mode: 'sheet' | 'page';
}
const { mode } = Astro.props;

// Most people book one or two everyday services: show those first, the rest behind "More".
const TOP = ['Wash & Fold', 'Steam Ironing', 'Dry Cleaning'];
const top = TOP.map((n) => services.find((s) => s.name === n)!).filter(Boolean);
const more = services.filter((s) => !TOP.includes(s.name));
const sub: Record<string, string> = {
  'Wash & Fold': 'Washed, folded & ironed · ₹100/kg',
  'Steam Ironing': 'Ironing only',
  'Dry Cleaning': 'Suits, silks & delicates',
};
---

<div class="wz" data-wizard data-mode={mode}>
  <header class="wz__head">
    <span class="wz__side"></span>
    <h2 class:list={['wz__title', { 'wz__title--brand': mode === 'page' }]} id="wz-title" data-wz-title>
      {mode === 'page' ? 'dhobermans' : 'Book a pickup'}
    </h2>
    {
      mode === 'sheet' ? (
        <button type="button" class="wz__icon" data-wz-close aria-label="Close">
          <Icon name="x" size={20} />
        </button>
      ) : (
        <details class="wz__menu">
          <summary class="wz__icon" aria-label="Menu">
            <Icon name="more" size={20} />
          </summary>
          <nav>
            <a href="/care/"><Icon name="bag" size={18} /> Shop care products</a>
            <a href={wa(msg.question)} data-flow="question" data-flow-topic="track"><Icon name="truck" size={18} /> Where is my order?</a>
            <a href={wa(msg.question)} data-flow="question"><Icon name="whatsapp" size={18} /> Ask a question</a>
            <a href={wa(msg.question)} data-flow="business"><Icon name="briefcase" size={18} /> Business quote</a>
            <a href="/"><Icon name="arrow-up-right" size={18} /> Visit the website</a>
            <button type="button" data-forget><Icon name="trash" size={18} /> Forget my saved details</button>
          </nav>
        </details>
      )
    }
  </header>

  <ol class="stepper" data-stepper aria-label="Booking steps"></ol>

  <div class="wz__body" data-wz-body>
    <!-- 1. Service -->
    <section class="panel" data-panel="service" hidden>
      <h3 class="q">What needs care?</h3>
      <div class="svc-top">
        {
          top.map((s) => (
            <label class="svc">
              <input type="checkbox" name="wz-svc" value={s.name} />
              <span class="svc__img">
                <Image src={s.image} alt="" widths={[120, 200]} sizes="72px" loading="lazy" />
              </span>
              <span class="svc__text">
                <strong>{s.name}</strong>
                <small>{sub[s.name]}</small>
              </span>
              <span class="svc__tick"><Icon name="check" size={14} /></span>
            </label>
          ))
        }
      </div>
      <button type="button" class="more" data-more aria-expanded="false" aria-controls="wz-more">
        More services <span>({more.length})</span>
        <Icon name="chevron-down" size={18} />
      </button>
      <div class="pills" id="wz-more" hidden>
        {
          more.map((s) => (
            <label class="pill">
              <input type="checkbox" name="wz-svc" value={s.name} />
              <span>{s.name}</span>
            </label>
          ))
        }
      </div>
      <p class="note" data-peritem hidden></p>

      <!-- Shown when Wash & Fold is selected -->
      <div class="wash" data-wash hidden>
        <h3 class="q q--sm">How much laundry? <em>(optional)</em></h3>
        <div class="pills" role="radiogroup" aria-label="Estimated load" data-group="load" data-optional>
          {
            LOAD_SIZES.map((kg) => (
              <button type="button" role="radio" class="opt" data-val={kg} aria-checked="false">
                {kg >= LOAD_MAX ? `${kg} kg+` : `~${kg} kg`}
              </button>
            ))
          }
        </div>
        <p class="note" data-est>1 kg is roughly 5 T-shirts or 2 bath towels.</p>

        <label class="field">
          <span>Plan</span>
          <select class="input" data-f="plan">
            {planOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </label>

        <details class="prefs">
          <summary>
            <span>Wash preferences <em>(optional)</em></span>
            <Icon name="chevron-down" size={18} />
          </summary>
          <div class="prefs__body">
            <span class="lbl">Detergent</span>
            <div class="pills" role="radiogroup" aria-label="Detergent" data-group="detergent">
              <button type="button" role="radio" class="opt" data-val="" aria-checked="true">No preference</button>
              <button type="button" role="radio" class="opt" data-val="Cloud Wash" aria-checked="false">
                Cloud Wash<small>Ultra-gentle, plant-based</small>
              </button>
              <button type="button" role="radio" class="opt" data-val="Fresh Breeze" aria-checked="false">
                Fresh Breeze<small>For everyday loads</small>
              </button>
            </div>
            <label class="check">
              <input type="checkbox" data-softener />
              <span>Add fabric softener (Petal Soft)</span>
            </label>
          </div>
        </details>
      </div>
    </section>

    <!-- 2. Time -->
    <section class="panel" data-panel="time" hidden>
      <h3 class="q">When should we pick up?</h3>
      <div class="days" role="radiogroup" aria-label="Pickup day" data-days></div>
      <div class="windows" role="radiogroup" aria-label="Pickup time" data-windows></div>
      <p class="eta" data-eta hidden><Icon name="truck" size={20} /><span data-eta-text></span></p>

      <h3 class="q q--sm q--gap">Repeat this pickup?</h3>
      <div class="seg" role="radiogroup" aria-label="Repeat" data-group="repeat">
        <button type="button" role="radio" data-val="once" aria-checked="true">Just once</button>
        <button type="button" role="radio" data-val="weekly" aria-checked="false">Every week</button>
        <button type="button" role="radio" data-val="biweekly" aria-checked="false">Every 2 weeks</button>
      </div>
    </section>

    <!-- 3. Address -->
    <section class="panel" data-panel="where" hidden>
      <div class="items" data-items hidden></div>
      <h3 class="q" data-where-q>Where should we pick up?</h3>

      <div class="loc">
        <div class="loc__actions" data-loc-actions>
          <button type="button" class="loc__btn" data-gps>
            <span class="loc__icon"><Icon name="locate" size={20} /></span>
            <span><strong>Use my current location</strong><small>Quickest: we get your exact pin</small></span>
          </button>
          <button type="button" class="loc__btn" data-mapbtn>
            <span class="loc__icon"><Icon name="map" size={20} /></span>
            <span><strong>Pick on a map</strong><small>Move the map to your door</small></span>
          </button>
        </div>
        <p class="loc__status" data-loc-status aria-live="polite"></p>

        <div class="pinned" data-pinned hidden>
          <span class="pinned__ok"><Icon name="check" size={16} /></span>
          <span class="pinned__text"><strong>Location pinned</strong><small data-pinned-text></small></span>
          <a class="pinned__link" data-pinned-link href="#" target="_blank" rel="noopener">View</a>
          <button type="button" class="pinned__link" data-pin-change>Change</button>
        </div>

        <div class="map" data-map hidden>
          <div class="map__canvas" data-map-canvas></div>
          <span class="map__pin" aria-hidden="true"><Icon name="map-pin" size={38} stroke={2.2} /></span>
          <div class="map__bar">
            <button type="button" class="btn btn--ghost btn--sm" data-map-locate><Icon name="locate" size={16} /> My location</button>
            <button type="button" class="btn btn--primary btn--sm" data-map-confirm>Use this spot</button>
          </div>
        </div>
      </div>

      <div class="grid2">
        <label class="field full">
          <span>House / flat, street and landmark</span>
          <input class="input" type="text" autocomplete="street-address" placeholder="e.g. Flat 302, 12th Main, near the park" data-f="address" />
        </label>
        <label class="field">
          <span>Pincode <em data-pin-optional hidden>(optional)</em></span>
          <input class="input" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="560102" data-f="pincode" />
        </label>
        <label class="field">
          <span>Your name</span>
          <input class="input" type="text" autocomplete="name" data-f="name" />
        </label>
        <small class="pin full" data-pin-status aria-live="polite"></small>
        <label class="field full">
          <span>Notes <em>(optional)</em></span>
          <input class="input" type="text" placeholder="Gate code, delicate items..." data-f="notes" />
        </label>
      </div>
      <p class="privacy">Your details only go into your WhatsApp message and are saved on this device for next time.</p>
    </section>

    <!-- Business quote -->
    <section class="panel" data-panel="business" hidden>
      <h3 class="q">Tell us about your business</h3>
      <label class="field">
        <span>Business name</span>
        <input class="input" type="text" autocomplete="organization" data-f="bizname" />
      </label>
      <div class="field">
        <span>Type</span>
        <div class="pills" role="radiogroup" aria-label="Business type" data-group="biztype" data-optional>
          <button type="button" role="radio" class="opt" data-val="Office" aria-checked="false">Office</button>
          <button type="button" role="radio" class="opt" data-val="Hostel or PG" aria-checked="false">Hostel or PG</button>
          <button type="button" role="radio" class="opt" data-val="Short-stay host" aria-checked="false">Short-stay host</button>
          <button type="button" role="radio" class="opt" data-val="Other" aria-checked="false">Other</button>
        </div>
      </div>
      <div class="field">
        <span>Laundry per month</span>
        <div class="pills" role="radiogroup" aria-label="Laundry per month" data-group="bizvolume" data-optional>
          <button type="button" role="radio" class="opt" data-val="Under 100 kg" aria-checked="false">Under 100 kg</button>
          <button type="button" role="radio" class="opt" data-val="100–249 kg" aria-checked="false">100–249 kg</button>
          <button type="button" role="radio" class="opt" data-val="250 kg or more" aria-checked="false">250 kg+</button>
          <button type="button" role="radio" class="opt" data-val="Not sure yet" aria-checked="false">Not sure</button>
        </div>
      </div>
      <div class="field">
        <span>Pickups</span>
        <div class="pills" role="radiogroup" aria-label="Pickup frequency" data-group="bizfreq" data-optional>
          <button type="button" role="radio" class="opt" data-val="Daily" aria-checked="false">Daily</button>
          <button type="button" role="radio" class="opt" data-val="2–3 times a week" aria-checked="false">2–3 times a week</button>
          <button type="button" role="radio" class="opt" data-val="Weekly" aria-checked="false">Weekly</button>
          <button type="button" role="radio" class="opt" data-val="Not sure yet" aria-checked="false">Not sure</button>
        </div>
      </div>
      <div class="grid2">
        <label class="field">
          <span>Your name</span>
          <input class="input" type="text" autocomplete="name" data-f="name4" />
        </label>
        <label class="field">
          <span>Area or pincode</span>
          <input class="input" type="text" autocomplete="postal-code" data-f="area" />
        </label>
        <label class="field full">
          <span>Notes <em>(optional)</em></span>
          <input class="input" type="text" placeholder="Linen, uniforms, towels..." data-f="notes4" />
        </label>
      </div>
    </section>

    <!-- Question -->
    <section class="panel" data-panel="ask" hidden>
      <h3 class="q">How can we help?</h3>
      <div class="pills" data-topics>
        <button type="button" class="opt" data-topic="track">Where is my order?</button>
        <button type="button" class="opt" data-topic="reschedule">Reschedule a pickup</button>
        <button type="button" class="opt" data-topic="issue">Report an issue</button>
        <button type="button" class="opt" data-topic="label">Read a care label</button>
      </div>
      <label class="field">
        <span>Your question</span>
        <textarea class="input" rows="4" placeholder="Type your question" data-f="question"></textarea>
      </label>
      <label class="field">
        <span>Your name</span>
        <input class="input" type="text" autocomplete="name" data-f="name2" />
      </label>
    </section>

    <!-- Location alert -->
    <section class="panel" data-panel="notify" hidden>
      <h3 class="q">Get notified</h3>
      <p class="lead-sm" data-notify-text></p>
      <label class="field">
        <span>Your name</span>
        <input class="input" type="text" autocomplete="name" data-f="name3" />
      </label>
      <label class="field">
        <span>Pincode <em>(optional)</em></span>
        <input class="input" type="text" inputmode="numeric" autocomplete="postal-code" data-f="pincode3" />
      </label>
    </section>

    <!-- Review -->
    <section class="panel panel--center" data-panel="review" hidden>
      <h3 class="q">Review your message</h3>
      <p class="lead-sm">WhatsApp opens with this message ready. Just tap send.</p>
      <div class="chat">
        <div class="chat__head">
          <span class="chat__avatar"><Icon name="whatsapp" size={16} /></span>
          <span><strong>dhobermans</strong><small>WhatsApp</small></span>
        </div>
        <div class="chat__body"><p class="bubble" data-preview></p></div>
      </div>
      <button type="button" class="link" data-edit>Edit details</button>
      {
        site.marketing.brevo && (
          <div class="offers">
            <label class="offers__check">
              <input type="checkbox" data-f="consent" />
              <span>Send me offers and pickup reminders by SMS or WhatsApp</span>
            </label>
            <label class="field offers__phone" data-offers-phone hidden>
              <span>Mobile number</span>
              <input class="input" type="tel" inputmode="tel" autocomplete="tel" placeholder="98765 43210" data-f="phone" />
            </label>
            <small>Optional. You can stop these messages at any time. See our <a href="/privacy/">privacy notice</a>.</small>
          </div>
        )
      }
    </section>

    <!-- Done -->
    <section class="panel panel--center done" data-panel="done" hidden>
      <div class="bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <span class="done__ok"><Icon name="check" size={30} /></span>
      <h3 class="q">Finish in WhatsApp</h3>
      <p class="lead-sm">Your message is ready in WhatsApp. Tap <strong>send</strong> there and we'll reply shortly.</p>
      <div class="prep" data-prep hidden>
        <strong>Before we arrive</strong>
        <ul>
          <li><Icon name="check" size={16} />Empty all pockets</li>
          <li><Icon name="check" size={16} />Keep dry-clean items in a separate bag</li>
          <li><Icon name="check" size={16} />Keep your laundry ready at the door</li>
        </ul>
      </div>
      <div class="done__actions">
        <button type="button" class="btn btn--ghost btn--block" data-ics hidden><Icon name="calendar" size={18} /> <span data-ics-label>Add to my calendar</span></button>
        <button type="button" class="btn btn--ghost btn--block" data-clearcart hidden>Clear my cart</button>
      </div>
    </section>
  </div>

  <footer class="wz__foot">
    <p class="wz__sum" data-wz-sum></p>
    <p class="wz__hint" data-wz-hint aria-live="polite"></p>
    <div class="wz__actions">
      <button type="button" class="btn btn--ghost" data-wz-back>Back</button>
      <button type="button" class="btn btn--primary" data-wz-next>Continue</button>
      <a class="btn btn--wa" href={wa()} target="_blank" rel="noopener" data-wz-send hidden>
        <Icon name="whatsapp" size={20} /> Open WhatsApp
      </a>
      <button type="button" class="btn btn--primary" data-wz-finish hidden>Done</button>
    </div>
  </footer>
</div>

<style>
  .wz {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;
    background: var(--white);
    color: var(--text);
  }

  .wz[data-mode='page'] {
    max-width: 640px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0 auto;
  }

  /*
    App screen: the page itself scrolls, so the list must not be a scroll container. Chrome (Android)
    applies overscroll-behavior to containers that have nothing to scroll, which stopped touches that
    started on the list from scrolling the page. The footer stays pinned so Continue is always in reach.
  */
  .wz[data-mode='page'] .wz__body {
    overflow: visible;
    overscroll-behavior: auto;
  }

  .wz[data-mode='page'] .wz__foot {
    position: sticky;
    bottom: 0;
    z-index: 3;
  }

  /* Header */
  .wz__head {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    padding: 18px 20px 6px;
  }

  .wz[data-mode='page'] .wz__head {
    padding-top: calc(12px + env(safe-area-inset-top));
  }

  .wz__title {
    font-size: 19px;
    text-align: center;
  }

  .wz__title--brand {
    color: var(--brand);
    font-size: 21px;
  }

  .wz__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .wz__icon::-webkit-details-marker {
    display: none;
  }

  .wz__menu {
    position: relative;
  }

  .wz__menu nav {
    position: absolute;
    top: 46px;
    right: 0;
    z-index: 10;
    display: grid;
    min-width: 250px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .wz__menu nav a,
  .wz__menu nav button {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink);
    font-size: 15px;
    text-align: left;
    cursor: pointer;
  }

  .wz__menu nav a:hover,
  .wz__menu nav button:hover {
    background: var(--surface);
  }

  /* Stepper */
  .stepper {
    display: flex;
    margin: 0;
    padding: 14px 28px 18px;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  .stepper :global(.st) {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .stepper :global(.st:not(:first-child)::before) {
    content: '';
    position: absolute;
    top: 16px;
    right: calc(50% + 22px);
    left: calc(-50% + 22px);
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    transition: background-color 0.3s ease;
  }

  .stepper :global(.st.is-done::before),
  .stepper :global(.st.is-current::before) {
    background: var(--brand);
  }

  .stepper :global(.st__dot) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 2px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--subtle);
    font-size: 15px;
    font-weight: 600;
    cursor: default;
    transition: all 0.25s ease;
  }

  .stepper :global(.st.is-current .st__dot) {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--white);
    box-shadow: 0 0 0 5px var(--brand-100);
  }

  .stepper :global(.st.is-done .st__dot) {
    border-color: var(--brand);
    background: var(--brand-50);
    color: var(--brand);
    cursor: pointer;
  }

  .stepper :global(.st__label) {
    color: var(--subtle);
    font-size: 13px;
    font-weight: 500;
  }

  .stepper :global(.st.is-current .st__label),
  .stepper :global(.st.is-done .st__label) {
    color: var(--ink);
  }

  /* Body */
  .wz__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 24px 28px 28px;
  }

  .panel {
    display: grid;
    gap: 14px;
    animation: panel-in 0.25s ease;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .panel--center {
    justify-items: center;
    text-align: center;
  }

  .q {
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
  }

  .q--sm {
    font-size: 16px;
  }

  .q--gap {
    margin-top: 10px;
  }

  .q em,
  .field em,
  .prefs em {
    color: var(--subtle);
    font-style: normal;
    font-weight: 500;
  }

  .lead-sm {
    max-width: 420px;
    color: var(--muted);
    font-size: 15px;
  }

  .note {
    color: var(--muted);
    font-size: 14px;
  }

  .lbl {
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  /* Services */
  .svc-top {
    display: grid;
    gap: 10px;
  }

  .svc {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 10px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .svc input,
  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .svc__img {
    flex: none;
    overflow: hidden;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .svc__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    line-height: 1.3;
  }

  .svc__text strong {
    color: var(--ink);
    font-weight: 600;
  }

  .svc__text small {
    color: var(--muted);
    font-size: 14px;
  }

  .svc__tick {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: transparent;
  }

  .svc:has(input:checked) {
    border-color: var(--brand);
    background: var(--brand-50);
  }

  .svc:has(input:checked) .svc__tick {
    background: var(--brand);
    box-shadow: none;
    color: var(--white);
  }

  .svc:has(input:focus-visible),
  .pill:has(input:focus-visible) {
