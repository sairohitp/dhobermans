---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  heading: string;
  rows: string[];
  cta: string;
}
const { icon, heading, rows, cta } = Astro.props;
---

<div class="phone" aria-hidden="true">
  <div class="phone__notch"></div>
  <div class="phone__screen">
    <div class="phone__status"><span>10:01</span><span class="phone__battery"></span></div>
    <div class="phone__brand">dhobermans</div>
    <div class="phone__title">
      <span class="phone__icon"><Icon name={icon} size={16} /></span>
      {heading}
    </div>
    <ul class="phone__rows">
      {rows.map((r, i) => <li class={i === 0 ? 'is-active' : ''}>{r}</li>)}
    </ul>
    <div class="phone__bar">{cta}</div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 232px;
    height: 364px;
    margin-inline: auto;
    padding: 9px 9px 0;
    border-radius: 30px 30px 0 0;
    background: #121212;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.45);
  }

  .phone__notch {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 1;
    width: 74px;
    height: 20px;
    border-radius: 999px;
    background: #121212;
    transform: translateX(-50%);
  }

  .phone__screen {
    height: 100%;
    padding: 44px 16px 0;
    border-radius: 22px 22px 0 0;
    background: var(--white);
    color: var(--ink);
    font-size: 12px;
  }

  .phone__status {
    position: absolute;
    top: 19px;
    left: 30px;
    right: 26px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
  }

  .phone__battery {
    width: 20px;
    height: 10px;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--ink) 70%, transparent 70%) 1px 1px / calc(100% - 2px) calc(100% - 2px) no-repeat;
  }

  .phone__brand {
    margin-bottom: 10px;
    color: var(--brand);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--tracking);
  }

  .phone__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }

  .phone__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--brand-50);
    color: var(--brand);
  }

  .phone__rows {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phone__rows li {
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font-weight: 600;
  }

  .phone__rows li.is-active {
    border-color: var(--brand-200);
    background: var(--brand-50);
    color: var(--brand-700);
  }

  .phone__bar {
    display: grid;
    place-items: center;
    height: 40px;
    margin-top: 14px;
    border-radius: 8px;
    background: var(--brand);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
  }
</style>
