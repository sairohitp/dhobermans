---
import Icon from './Icon.astro';
import { services } from '../data';
import { wa } from '../lib/wa';
---

<div class="builder" data-builder>
  <div class="builder__form">
    <div class="bstep">
      <span class="bstep__num">1</span>
      <div class="bstep__body">
        <label class="bstep__label" for="pb-pin">Where should we pick up?</label>
        <input
          id="pb-pin"
          class="input"
          type="text"
          inputmode="numeric"
          autocomplete="postal-code"
          placeholder="Your 6-digit pincode"
          data-pin
        />
        <p class="pin-status" data-pin-status aria-live="polite">We serve all of Bangalore.</p>
      </div>
    </div>

    <div class="bstep">
      <span class="bstep__num">2</span>
      <div class="bstep__body">
        <span class="bstep__label" id="pb-slot-label">Pick a preferred slot</span>
        <div class="choices" role="radiogroup" aria-labelledby="pb-slot-label" data-slots></div>
      </div>
    </div>

    <div class="bstep">
      <span class="bstep__num">3</span>
      <div class="bstep__body">
        <span class="bstep__label" id="pb-svc-label">What needs care?</span>
        <div class="choices" role="group" aria-labelledby="pb-svc-label">
          {
            services.map((s) => (
              <label class="choice">
                <input type="checkbox" value={s.name} data-svc />
                <span>{s.name}</span>
              </label>
            ))
          }
        </div>
      </div>
    </div>

    <div class="bstep">
      <span class="bstep__num">4</span>
      <div class="bstep__body bstep__body--row">
        <label class="sub">
          <span class="bstep__label">Your name <em>(optional)</em></span>
          <input class="input" type="text" autocomplete="name" placeholder="Name" data-name />
        </label>
        <label class="sub">
          <span class="bstep__label">Notes <em>(optional)</em></span>
          <input class="input" type="text" placeholder="Gate code, delicate items..." data-notes />
        </label>
      </div>
    </div>
  </div>

  <aside class="preview" aria-label="Your WhatsApp message">
    <div class="preview__head">
      <span class="preview__avatar"><Icon name="whatsapp" size={18} /></span>
      <div>
        <strong>dhobermans</strong>
        <span>Message preview</span>
      </div>
    </div>
    <div class="preview__chat">
      <p class="bubble" data-preview>Hi dhobermans, I'd like to schedule a laundry pickup.</p>
    </div>
    <a class="btn btn--wa btn--block" href={wa()} target="_blank" rel="noopener" data-send>
      <Icon name="whatsapp" size={20} /> Send on WhatsApp
    </a>
    <button type="button" class="btn btn--ghost btn--block btn--sm" data-ics disabled>
      <Icon name="bell" size={18} /> Add a weekly pickup reminder
    </button>
    <p class="preview__note">The reminder downloads as a calendar file for the slot you pick.</p>
  </aside>
</div>

<style>
  .builder {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .builder__form {
    display: grid;
    gap: 4px;
    padding: clamp(16px, 2.5vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .bstep {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    padding: 14px 0;
  }

  .bstep + .bstep {
    border-top: 1px dashed var(--line);
  }

  .bstep__num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
  }

  .bstep__body {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .bstep__body--row {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .sub {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .bstep__label {
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    line-height: 32px;
  }

  .sub .bstep__label {
    line-height: 1.3;
  }

  .bstep__label em {
    color: var(--subtle);
    font-style: normal;
    font-weight: 500;
  }

  .input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .input:focus {
    border-color: var(--brand);
    background: var(--white);
    box-shadow: 0 0 0 4px var(--brand-100);
    outline: none;
  }

  .pin-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }

  .pin-status.is-ok {
    color: #0f7b46;
  }

  .pin-status.is-maybe {
    color: #a15c00;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choices :global(.choice) {
    position: relative;
    cursor: pointer;
  }

  .choices :global(.choice input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .choices :global(.choice span) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .choices :global(.choice input:checked + span) {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--white);
  }

  .choices :global(.choice input:focus-visible + span) {
    box-shadow: 0 0 0 4px var(--brand-100);
  }

  .preview {
    position: sticky;
    top: calc(var(--header-h) + 20px);
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--ink);
    box-shadow: var(--shadow-lg);
  }

  .preview__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 6px 8px;
    color: var(--white);
  }

  .preview__head div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .preview__head span:not(.preview__avatar) {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
  }

  .preview__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--wa);
    color: var(--white);
  }

  .preview__chat {
    min-height: 180px;
    padding: 18px 14px;
    border-radius: 18px;
    background:
      radial-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px) 0 0 / 12px 12px,
      #efeae2;
  }

  .bubble {
    position: relative;
    margin-left: auto;
    max-width: 92%;
    padding: 10px 12px;
    border-radius: 12px 2px 12px 12px;
    background: #d9fdd3;
    color: #111b21;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-line;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }

  .preview .btn--ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--white);
  }

  .preview .btn--ghost:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .preview__note {
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .builder {
      grid-template-columns: 1fr;
    }

    .preview {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .bstep {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .bstep__num {
      display: none;
    }

    .bstep__body--row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { site } from '../config';
  import { nextSlots, buildIcs, pincodeStatus } from '../lib/slots';
  import { profile } from '../lib/store';

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-builder]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const pin = root.querySelector<HTMLInputElement>('[data-pin]')!;
    const pinStatus = root.querySelector<HTMLElement>('[data-pin-status]')!;
    const slotWrap = root.querySelector<HTMLElement>('[data-slots]')!;
    const nameInput = root.querySelector<HTMLInputElement>('[data-name]')!;
    const notesInput = root.querySelector<HTMLInputElement>('[data-notes]')!;
    const preview = root.querySelector<HTMLElement>('[data-preview]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]')!;
    const icsBtn = root.querySelector<HTMLButtonElement>('[data-ics]')!;

    const options = nextSlots();
    slotWrap.innerHTML = options
      .map(
        (o) =>
          `<label class="choice"><input type="radio" name="pb-slot" value="${o.id}" /><span>${o.label}</span></label>`,
      )
      .join('');

    const selectedSlot = () => {
      const id = slotWrap.querySelector<HTMLInputElement>('input:checked')?.value;
      return options.find((o) => o.id === id);
    };

    const pinState = () => pincodeStatus(pin.value);

    const update = () => {
      pin.value = pin.value.replace(/\D/g, '').slice(0, 6);
      const ps = pinState();
      pinStatus.textContent = ps.text;
      pinStatus.className = `pin-status ${ps.cls}`;

      const svcs = [...root.querySelectorAll<HTMLInputElement>('[data-svc]:checked')].map((i) => i.value);
      const slot = selectedSlot();
      const lines = [
        "Hi dhobermans, I'd like to schedule a pickup.",
        svcs.length ? `Services: ${svcs.join(', ')}` : '',
        slot ? `Preferred slot: ${slot.long}` : '',
        /^\d{6}$/.test(pin.value) ? `Pincode: ${pin.value}` : '',
        nameInput.value.trim() ? `Name: ${nameInput.value.trim()}` : '',
        notesInput.value.trim() ? `Notes: ${notesInput.value.trim()}` : '',
      ].filter(Boolean);
      const text = lines.join('\n');
      preview.textContent = text;
      send.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`;
      icsBtn.disabled = !slot;
    };

    root.addEventListener('input', update);
    root.addEventListener('change', update);

    icsBtn.addEventListener('click', () => {
      const slot = selectedSlot();
      if (!slot) return;
      const blob = new Blob([buildIcs(slot, site.whatsapp)], { type: 'text/calendar;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'dhobermans-weekly-pickup.ics';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });

    // Preselect a service from links such as /?service=dry-cleaning#book
    // Prefill details saved on this device from an earlier request.
    const saved = profile.get();
    if (saved.pincode && !pin.value) pin.value = saved.pincode;
    if (saved.name && !nameInput.value) nameInput.value = saved.name;
    send.addEventListener('click', () => profile.save({ ...profile.get(), name: nameInput.value, pincode: pin.value }));

    const params = new URLSearchParams(window.location.search);
    const svc = params.get('service');
    if (svc) {
      root.querySelectorAll<HTMLInputElement>('[data-svc]').forEach((i) => {
        if (i.value.toLowerCase().replace(/[^a-z]+/g, '-') === svc) i.checked = true;
      });
    }
    update();
  };

  document.addEventListener('astro:page-load', init);
</script>
