---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cart from '../components/Cart.astro';
import { products, productCategories, categoryIcon } from '../data';
import { site } from '../config';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "dhobermans' care products",
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      description: p.body,
      category: p.category,
      brand: { '@type': 'Brand', name: 'dhobermans' },
      offers: { '@type': 'Offer', price: p.amount, priceCurrency: 'INR', url: `${site.url}/care/` },
    },
  })),
};
---

<Base
  title="dhobermans' care | Laundry detergents and fabric care in Bangalore"
  description="Shop dhobermans' care: plant-based detergents, comforter wash, reed diffusers and linen sprays. Add to cart and order on WhatsApp in Bangalore."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
  <section class="care-hero">
    <div class="container">
      <a href="/" class="back"><Icon name="arrow-right" size={16} class="back__icon" /> Back to home</a>
      <h1 class="h1">Care for what <span class="accent">you wear.</span></h1>
      <p class="lead">Our line of detergents, comforter washes, diffusers, and fragrances, crafted to keep your fabrics and spaces feeling brand new.</p>
    </div>
  </section>

  <section class="section catalog">
    <div class="container">
      <div class="filters" role="toolbar" aria-label="Filter products by category">
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All</button>
        {
          productCategories.map((c) => (
            <button type="button" class="filter" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>

      <div class="grid">
        {
          products.map((p) => (
            <article class="item" data-category={p.category}>
              <div class="item__art">
                <Icon name={categoryIcon[p.category]} size={44} stroke={1.5} />
              </div>
              <div class="item__body">
                <span class="item__meta">{p.category} · {p.size}</span>
                <h2>{p.name}</h2>
                <p>{p.body}</p>
                <div class="item__foot">
                  <span class="item__price">{p.price}</span>
                  <div class="item__ctl" data-cart-ctl={p.slug}>
                    <button type="button" class="btn btn--primary btn--sm add" data-qty-inc={p.slug}>Add to cart</button>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="note">Add what you need, then send the whole order to us on WhatsApp in one message.</p>
    </div>
  </section>
  <Cart />
</Base>

<style>
  .care-hero {
    padding-block: clamp(40px, 6vw, 80px) 8px;
    background: radial-gradient(60% 90% at 0% 0%, rgba(0, 123, 255, 0.1), transparent 70%);
  }

  .back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
  }

  .back:hover {
    color: var(--brand);
  }

  .back :global(.back__icon) {
    transform: rotate(180deg);
  }

  .catalog {
    padding-top: 40px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .filter {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: var(--white);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter:hover {
    border-color: var(--brand-200);
  }

  .filter.is-active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .item {
    display: flex;
    flex-direction: column;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .item:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .item[hidden] {
    display: none;
  }

  .item__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--brand-50), #ffffff 90%);
    color: var(--brand);
  }

  .item__meta {
    color: var(--subtle);
    font-size: 14px;
    font-weight: 500;
  }

  .item__ctl {
    display: flex;
    justify-content: flex-end;
    min-height: 44px;
  }

  .item__ctl :global(.add) {
    min-height: 44px;
  }

  .item__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 18px 8px 6px;
  }

  .item h2 {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 19px;
    letter-spacing: var(--tracking);
    line-height: 1.25;
  }

  .item p {
    flex: 1;
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .item__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    margin-top: 20px;
  }

  .item__price {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: var(--tracking);
  }

  .note {
    margin-top: 32px;
    color: var(--muted);
    font-size: 15px;
    text-align: center;
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .filters {
      flex-wrap: nowrap;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filters::-webkit-scrollbar {
      display: none;
    }

    .filter {
      flex: none;
      min-height: 44px;
    }

    .item {
      padding: 8px;
      border-radius: var(--radius-lg);
    }

    .item__art {
      border-radius: var(--radius-lg);
    }

    .item__body {
      padding: 12px 4px 4px;
    }

    .item h2 {
      font-size: 16px;
    }

    .item p {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 13px;
    }

    .item__foot {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      margin-top: 14px;
    }

    .item__price {
      font-size: 20px;
    }

    .item__ctl,
    .item__ctl :global(.add),
    .item__ctl :global(.qty) {
      width: 100%;
    }

    .item__ctl :global(.qty) {
      justify-content: space-between;
    }

    .item__meta {
      font-size: 13px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      items.forEach((it) => {
        it.hidden = f !== 'all' && it.dataset.category !== f;
      });
    });
  });
  });
</script>
