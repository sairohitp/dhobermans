---
import { Image } from 'astro:assets';
import Content from '../../layouts/Content.astro';
import { site } from '../../config';
import { services, pricing, steps } from '../../data';
import { servicePages, faqSchema } from '../../seo';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug)!;
const page = servicePages[slug!];
const others = services.filter((s) => s.slug !== slug);
const url = `${site.url}/services/${slug}/`;

const serviceSchema: Record<string, unknown> = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: service.name,
  serviceType: service.name,
  description: page.description,
  url,
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'City', name: 'Bengaluru', alternateName: 'Bangalore' },
};
if (slug === 'wash-fold') {
  serviceSchema.offers = {
    '@type': 'Offer',
    priceCurrency: 'INR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: pricing.perKg,
      priceCurrency: 'INR',
      unitCode: 'KGM',
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'KGM' },
    },
  };
}
---

<Content
  title={page.title}
  description={page.description}
  h1={page.h1}
  lead={page.lead}
  crumbs={[{ label: 'Services', href: '/services/' }]}
  schema={[serviceSchema, faqSchema(page.faqs)]}
  flow="service"
  flowService={service.name}
  cta={`Book ${service.name}`}
>
  <Image class="shot" src={service.image} alt={`${service.name} by dhobermans in HSR Layout, Bangalore`} widths={[480, 760, 1200]} sizes="(max-width: 800px) 92vw, 760px" loading="eager" />

  <h2>{service.name} in HSR Layout, Bangalore</h2>
  {page.body.map((p) => <p>{p}</p>)}

  <ul class="facts">
    <li><span>Price</span><strong>{page.price}</strong></li>
    <li><span>Turnaround</span><strong>{page.time}</strong></li>
    <li><span>Pickup and delivery</span><strong>Free within {site.freeRadiusKm} km of {site.base.label}</strong></li>
  </ul>

  <h2>What is included</h2>
  <ul>
    {page.includes.map((i) => <li>{i}</li>)}
  </ul>

  <h2>How it works</h2>
  <ol>
    {steps.map((s) => <li><strong>{s.title}.</strong> {s.body}</li>)}
  </ol>
  <p>
    Pickups run in two windows, 9 to 11 AM and 6 to 8 PM. You book in under a minute and the request opens in WhatsApp, where we confirm it.
  </p>

  <h2>Questions about {service.name.toLowerCase()}</h2>
  {
    page.faqs.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))
  }

  <h2>Where we collect</h2>
  <p>
    We are based in {site.base.label}. Pickup and delivery are free within {site.freeRadiusKm} km, which covers HSR Layout and parts of the
    neighbouring areas. See <a href="/laundry-service-hsr-layout/">laundry service in HSR Layout</a> for the details.
  </p>

  <h2>Other services</h2>
  <ul class="links">
    {others.map((o) => <li><a href={`/services/${o.slug}/`}>{o.name}</a></li>)}
  </ul>
</Content>

<style>
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-bottom: 40px;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
</style>
