---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | dhobermans" description="The page you are looking for could not be found.">
  <section class="section">
    <div class="container nf">
      <h1 class="h1">This page went missing in the wash.</h1>
      <p class="lead">The link may be broken or the page may have moved.</p>
      <a href="/" class="btn btn--primary">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
  }

  .nf .h1,
  .nf .lead {
    max-width: 16ch;
    margin-inline: auto;
  }

  .nf .lead {
    max-width: 520px;
  }

  .nf .btn {
    margin-top: 32px;
  }
</style>
