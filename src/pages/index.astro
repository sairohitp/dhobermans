---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import PickupBuilder from '../components/PickupBuilder.astro';
import PlanFinder from '../components/PlanFinder.astro';
import StainSOS from '../components/StainSOS.astro';
import heroImage from '../assets/hero-laundry.jpg';
import { site } from '../config';
import { wa, msg } from '../lib/wa';
import { services, benefits, steps, plans, locations, products, categoryIcon, faqs } from '../data';

const featuredProducts = products.filter((p) => p.featured);
const marquee = ['Wash & Fold', 'Dry Cleaning', 'Steam Ironing', 'Free pickup & delivery', '48-hour turnaround', 'Eco-friendly care', 'Comforter Wash', 'Shoe Cleaning', 'Curtain Cleaning', 'Stain Removal'];
const hasApps = Boolean(site.playStore || site.appStore);
const ext = { target: '_blank', rel: 'noopener' };
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="chip hero__pill"><span class="dot"></span>Now serving {site.city} · Free pickup &amp; delivery</span>
        <h1 class="h1">Laundry, delivered <span class="accent">like magic.</span></h1>
        <p class="lead">Schedule a pickup. We wash, fold, and return your clothes fresh, clean, and on time. Every time.</p>

        <div class="hero__actions">
          <a href={wa()} {...ext} class="btn btn--wa"><Icon name="whatsapp" size={20} /> Book on WhatsApp</a>
          <a href="#book" class="btn btn--ghost"><Icon name="calendar" size={18} /> Plan a pickup</a>
        </div>

        <div class="hero__apps">
          {
            hasApps ? (
              <>
                {site.playStore && (
                  <a class="btn btn--dark btn--sm" href={site.playStore} {...ext}>Get it on Google Play</a>
                )}
                {site.appStore && (
                  <a class="btn btn--dark btn--sm" href={site.appStore} {...ext}>Download on the App Store</a>
                )}
              </>
            ) : (
              <span class="hero__soon">
                <Icon name="sparkle" size={16} /> The dhobermans app is coming soon
              </span>
            )
          }
          <button type="button" class="btn btn--dark btn--sm" data-install hidden>
            <Icon name="download" size={16} /> Install web app
          </button>
        </div>

        <ul class="hero__promises">
          <li><Icon name="clock" size={18} />48-hour turnaround</li>
          <li><Icon name="truck" size={18} />Door-to-door</li>
          <li><Icon name="leaf" size={18} />Eco-friendly care</li>
        </ul>
      </div>

      <div class="hero__media">
        <div class="hero__frame">
          <Image src={heroImage} alt="Freshly folded white towels on a marble counter" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" fetchpriority="high" />
        </div>
        <div class="float-card float-card--top">
          <span class="float-card__icon"><Icon name="truck" size={18} /></span>
          <div><strong>Pickup en route</strong><span>ETA · 12 mins</span></div>
        </div>
        <div class="float-card float-card--bottom">
          <span class="float-card__icon float-card__icon--ok"><Icon name="check" size={18} /></span>
          <div><strong>Order ready</strong><span>Washed · Folded · Delivered</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-label="What we take care of">
    <div class="marquee__track">
      {[0, 1].map((n) => (
        <ul aria-hidden={n === 1 ? 'true' : undefined}>
          {marquee.map((m) => <li>{m}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <!-- Why us -->
  <section id="why-us" class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why dhobermans?</span>
        <h2 class="h2">Fresh clothes, zero effort.</h2>
        <p class="lead">We come to you, clean with care, and bring everything back folded and on time.</p>
      </div>
      <div class="benefits">
        {
          benefits.map((b) => (
            <article class="benefit reveal">
              <span class="benefit__icon"><Icon name={b.icon} size={22} /></span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Our services</span>
        <h2 class="h2">Book trusted laundry care.</h2>
        <p class="lead">From everyday wash &amp; fold to delicate dry cleaning, dhobermans handles it all. Tap a service to book it on WhatsApp.</p>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <a class="service reveal" href={wa(msg.service(s.name))} {...ext} aria-label={`Book ${s.name} on WhatsApp`}>
              <div class="service__img">
                <Image src={s.image} alt="" widths={[320, 480]} sizes="(max-width: 640px) 46vw, 280px" />
              </div>
              <div class="service__foot">
                <h3>{s.name}</h3>
                <span class="service__arrow"><Icon name="arrow-up-right" size={16} /></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2 class="h2">Simple steps to fresher laundry.</h2>
        <p class="lead">Three taps. Zero hassle. Your laundry, handled end-to-end.</p>
      </div>
      <div class="steps swipe">
        {
          steps.map((s, i) => (
            <article class="step">
              <div class="step__card dots-bg">
                <PhoneMock {...s.screen} />
              </div>
              <span class="step__label">Step {i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
      <p class="swipe-hint">Swipe to see all steps <Icon name="arrow-right" size={14} /></p>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="section section--surface">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Pricing</span>
        <h2 class="h2">Simple, transparent pricing.</h2>
        <p class="lead">No hidden fees. Cancel anytime.</p>
      </div>
      <div class="plans swipe" data-plans>
        {
          plans.map((p) => (
            <article class:list={['plan', { 'plan--featured': p.featured }]} data-featured={p.featured ? 'true' : undefined}>
              <h3>{p.name}</h3>
              <p class="plan__tagline">{p.tagline}</p>
              <p class="plan__price">
                {p.price}
                <span>/month</span>
              </p>
              <ul>
                {p.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    {f}
                  </li>
                ))}
              </ul>
              <a href={wa(msg.plan(p.name, p.price))} {...ext} class:list={['btn btn--block', p.featured ? 'btn--white' : 'btn--primary']}>
                <Icon name="whatsapp" size={18} /> Choose {p.name}
              </a>
            </article>
          ))
        }
      </div>
      <p class="swipe-hint">Swipe to compare plans <Icon name="arrow-right" size={14} /></p>
      <PlanFinder />
    </div>
  </section>

  <!-- Locations -->
  <section id="locations" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Self-service · Coming soon</span>
        <h2 class="h2">Self-laundry locations.</h2>
        <p class="lead">Prefer doing it yourself? These are the neighbourhoods planned for future dhobermans self-service spots. Tap one to get notified when it opens.</p>
      </div>
      <div class="locations">
        <div class="map reveal" role="img" aria-label="Illustrative map of planned locations in Bangalore">
          <span class="map__label map__label--l">Bangalore</span>
          <span class="map__label map__label--r">Illustrative map</span>
          {
            locations.map((l) => (
              <span class="map__pin" style={`left:${l.x}%;top:${l.y}%`}>
                <span class="dot" />
                {l.name}
              </span>
            ))
          }
        </div>
        <ul class="loc-list">
          {
            locations.map((l) => (
              <li class="reveal">
                <a class="loc" href={wa(msg.location(l.name, l.address))} {...ext}>
                  <span class="loc__icon"><Icon name="map-pin" size={18} /></span>
                  <div>
                    <h3>{l.name}</h3>
                    <p>{l.address}</p>
                  </div>
                  <span class="loc__notify"><Icon name="bell" size={14} /> Notify me</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Care -->
  <section id="care" class="section section--surface">
    <div class="container">
      <div class="section-head care-head reveal">
        <div>
          <span class="eyebrow">dhobermans' care</span>
          <h2 class="h2">Care for what you wear.</h2>
          <p class="lead">Our own line of detergents, comforter washes, diffusers, and fragrances, crafted to keep your fabrics and spaces feeling brand new.</p>
        </div>
        <a href="/care" class="link-arrow">Explore the full collection <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="products">
        {
          featuredProducts.map((p) => (
            <a class="product reveal" href="/care">
              <div class="product__art">
                <Icon name={categoryIcon[p.category]} size={40} stroke={1.5} />
              </div>
              <span class="tag">{p.category}</span>
              <h3>{p.name}</h3>
              <p>{p.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Stain SOS -->
  <section id="stain-sos" class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Stain SOS</span>
        <h2 class="h2">Spilled something? Act fast.</h2>
        <p class="lead">Quick first aid for the most common stains, until we can take over.</p>
      </div>
      <StainSOS />
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">FAQs</span>
        <h2 class="h2">Frequently asked questions.</h2>
      </div>
      <div class="faqs">
        {
          faqs.map((f) => (
            <details class="faq" name="faq">
              <summary>
                {f.q}
                <Icon name="chevron-down" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
        <a class="faq-more" href={wa(msg.question)} {...ext}>
          <span>Still have a question?</span>
          <strong><Icon name="whatsapp" size={18} /> Ask us on WhatsApp</strong>
        </a>
      </div>
    </div>
  </section>

  <!-- Pickup planner -->
  <section id="book" class="section section--surface">
    <div class="container" id="contact">
      <div class="section-head reveal">
        <span class="eyebrow">Pickup planner</span>
        <h2 class="h2">Ready to simplify laundry?</h2>
        <p class="lead">Check your area, pick a slot and services, and send it to us on WhatsApp in one tap.</p>
      </div>
      <PickupBuilder />
    </div>
  </section>
</Base>

<script>
  // On phones, open the pricing row on the featured plan.
  document.addEventListener('astro:page-load', () => {
    const row = document.querySelector<HTMLElement>('[data-plans]');
    const featured = row?.querySelector<HTMLElement>('[data-featured]');
    if (!row || !featured || window.innerWidth > 720) return;
    row.scrollLeft += featured.getBoundingClientRect().left - row.getBoundingClientRect().left - (row.clientWidth - featured.clientWidth) / 2;
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 7vw, 96px);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 0% 100%, rgba(0, 123, 255, 0.12), transparent 70%),
      radial-gradient(40% 50% at 100% 0%, rgba(0, 123, 255, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 50%;
    height: 60%;
    background-image: radial-gradient(rgba(0, 123, 255, 0.22) 1.2px, transparent 1.2px);
    background-size: 16px 16px;
    mask-image: radial-gradient(70% 80% at 0% 100%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 80% at 0% 100%, #000 10%, transparent 75%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .hero__pill {
    margin-bottom: 24px;
    font-size: 13px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__apps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .hero__soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
  }

  .hero__soon :global(svg) {
    color: var(--brand);
  }

  .hero__promises {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 28px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .hero__promises li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .hero__promises :global(svg) {
    color: var(--brand);
  }

  .hero__media {
    position: relative;
    padding: 28px 0 28px 28px;
  }

  .hero__frame {
    overflow: hidden;
    border-radius: var(--radius-xl);
    aspect-ratio: 4 / 4.4;
    box-shadow: var(--shadow-lg);
  }

  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    border: 1px solid rgba(231, 234, 240, 0.9);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }

  .float-card div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .float-card strong {
    color: var(--ink);
    font-size: 15px;
  }

  .float-card span:not(.float-card__icon) {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  .float-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--brand-50);
    color: var(--brand);
  }

  .float-card__icon--ok {
    background: var(--brand);
    color: var(--white);
  }

  .float-card--top {
    top: 56px;
    left: 0;
  }

  .float-card--bottom {
    right: -12px;
    bottom: 64px;
    animation-delay: -3s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    padding-block: 26px;
    border-top: 1px solid var(--line);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee ul {
    display: flex;
    gap: 48px;
    margin: 0;
    padding: 0 24px;
    list-style: none;
  }

  .marquee li {
    display: flex;
    align-items: center;
    gap: 48px;
    color: #9aa3af;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .marquee li::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-200);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Benefits */
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .benefit {
    padding: 28px;
    border: 1px solid rgba(0, 123, 255, 0.16);
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(0, 123, 255, 0.1), rgba(255, 255, 255, 0.6) 70%);
  }

  .benefit__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: var(--white);
    color: var(--brand);
    box-shadow: var(--shadow-sm);
  }

  .benefit h3 {
    font-size: 22px;
  }

  .benefit p {
    margin-top: 8px;
    color: var(--muted);
  }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .service {
    display: flex;
    flex-direction: column;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .service:hover {
    border-color: var(--brand-200);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .service__img {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 20px;
    background: var(--surface-2);
  }

  .service__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .service:hover .service__img :global(img) {
    transform: scale(1.05);
  }

  .service__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 6px 6px;
  }

  .service h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .service__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    transition: all 0.2s ease;
  }

  .service:hover .service__arrow {
    background: var(--brand);
    color: var(--white);
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .step__card {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 380px;
    padding-top: 40px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--brand);
  }

  .step__label {
    display: block;
    margin-top: 24px;
    color: #5aa8ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .step h3 {
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 24px;
    letter-spacing: -0.01em;
  }

  .step p {
    margin-top: 8px;
  }

  /* Plans */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 20px;
    max-width: 1080px;
    margin-inline: auto;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .plan h3 {
    font-size: 22px;
  }

  .plan__tagline {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
  }

  .plan__price {
    margin-top: 24px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .plan__price span {
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .plan ul {
    display: grid;
    gap: 12px;
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    flex: 1;
  }

  .plan li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 500;
  }

  .plan li :global(svg) {
    flex: none;
    color: var(--brand);
  }

  .plan--featured {
    border-color: var(--brand);
    background: var(--brand);
    color: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-lg);
  }

  .plan--featured h3,
  .plan--featured .plan__price {
    color: var(--white);
  }

  .plan--featured .plan__tagline,
  .plan--featured .plan__price span {
    color: rgba(255, 255, 255, 0.72);
  }

  .plan--featured li :global(svg) {
    color: var(--white);
  }

  /* Locations */
  .locations {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 24px;
  }

  .map {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(45% 55% at 45% 45%, rgba(0, 123, 255, 0.1), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--surface);
  }

  .map__label {
    position: absolute;
    top: 18px;
    color: var(--subtle);
