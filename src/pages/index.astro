---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import PlanFinder from '../components/PlanFinder.astro';
import StainSOS from '../components/StainSOS.astro';
import heroImage from '../assets/hero-laundry.jpg';
import CareLabels from '../components/CareLabels.astro';
import { site } from '../config';
import { faqSchema } from '../seo';
import { wa, msg } from '../lib/wa';
import { rupees } from '../lib/store';
import { services, steps, plans, pricing, packRate, packPrice, fullPrice, tierRate, locations, products, categoryIcon, faqs } from '../data';

const featuredProducts = products.filter((p) => p.featured);
const ext = { target: '_blank', rel: 'noopener' };
const defaultPack = pricing.defaultPack;
---

<Base schema={[faqSchema(faqs)]}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="h1 kinetic">
          <span class="w" style="--i:0">Laundry,</span>{' '}<span class="w" style="--i:1">delivered</span>{' '}<span class="accent"><span class="w" style="--i:2">like</span>{' '}<span class="w" style="--i:3">magic.</span></span>
        </h1>
        <p class="lead">Laundry and dry cleaning pickup and delivery across Bangalore. We wash, fold, and iron your clothes and bring them back within 24 hours.</p>
        <div class="hero__actions">
          <a href={wa()} {...ext} class="btn btn--wa" data-flow="pickup"><Icon name="whatsapp" size={20} /> Book a pickup</a>
          <a href="#pricing" class="btn btn--ghost">From ₹90/kg · See pricing</a>
        </div>
        <button type="button" class="hero__again" data-again hidden>
          <Icon name="repeat" size={16} /> <span data-again-text>Repeat my last order</span>
        </button>
        <div class="promise" data-promise>
          <div class="promise__cell">
            <span class="promise__k">Next pickup</span>
            <strong data-promise-pickup>Morning or evening</strong>
          </div>
          <span class="promise__arrow"><Icon name="arrow-right" size={18} /></span>
          <div class="promise__cell">
            <span class="promise__k">Back at your door</span>
            <strong data-promise-back>Within 24 hours</strong>
          </div>
          <p class="promise__note" data-promise-note>Free pickup &amp; delivery within 5 km of HSR Layout.</p>
        </div>
        <button type="button" class="hero__app" data-install hidden>
          <Icon name="download" size={16} /> Get the dhobermans app
        </button>
      </div>
      <div class="hero__media">
        <div class="hero__frame">
          <Image src={heroImage} alt="Freshly folded white towels on a marble counter" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" fetchpriority="high" />
        </div>
        <div class="float-card float-card--top">
          <span class="float-card__icon"><Icon name="truck" size={18} /></span>
          <div><strong>Pickup en route</strong><span>ETA · 12 mins</span></div>
        </div>
        <div class="float-card float-card--bottom">
          <span class="float-card__icon float-card__icon--ok"><Icon name="check" size={18} /></span>
          <div><strong>Order ready</strong><span>Washed · Folded · Ironed</span></div>
        </div>
      </div>
    </div>
  </section>


  <!-- Why us -->
  <section id="why-us" class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Fresh clothes, zero effort.</h2>
        <p class="lead">We come to you, clean with care, and bring everything back folded, ironed and on time.</p>
      </div>
      <div class="facts">
        <article class="fact reveal">
          <span class="fact__icon"><Icon name="clock" size={22} /></span>
          <h3>Back within <span class="accent">24 hours</span></h3>
          <p>Collected from your door, washed, folded, ironed and returned the next day.</p>
        </article>
        <article class="fact reveal">
          <span class="fact__icon"><Icon name="map-pin" size={22} /></span>
          <h3>Free pickup within <span class="accent">{site.freeRadiusKm} km</span></h3>
          <p>From our base in <span class="nowrap">{site.base.label}</span>. Further away? We will confirm the charge.</p>
          <button type="button" class="fact__btn" data-distance><Icon name="locate" size={16} /> Check my distance</button>
          <p class="fact__result" data-distance-result aria-live="polite"></p>
        </article>
        <article class="fact reveal">
          <span class="fact__icon"><Icon name="scale" size={22} /></span>
          <h3><span class="accent">{rupees(pricing.perKg)}</span> per kg, all in</h3>
          <p>Washing, folding and ironing, billed by weight. Monthly packs bring it to {rupees(packRate)} per kg.</p>
        </article>
      </div>

      <ul class="assure reveal">
        <li>
          <Icon name="shield" size={20} />
          <span><strong>Care guarantee.</strong> Any damage is covered: we compensate or replace the item.</span>
        </li>
        <li>
          <Icon name="leaf" size={20} />
          <span><strong>Eco-friendly care.</strong> Gentle detergents that are kind to clothes and the planet.</span>
        </li>
        <li>
          <Icon name="message" size={20} />
          <span><strong>Updates at every step.</strong> We keep you posted from pickup to delivery.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Book trusted laundry care.</h2>
        <p class="lead">From everyday wash &amp; fold to delicate dry cleaning, dhobermans handles it all. Tap a service to see what is included and book it.</p>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <a class="service reveal" href={`/services/${s.slug}/`}>
              <div class="service__img">
                <Image src={s.image} alt={`${s.name} by dhobermans in Bangalore`} widths={[320, 480]} sizes="(max-width: 640px) 46vw, 280px" />
              </div>
              <div class="service__foot">
                <h3>{s.name}</h3>
                <span class="service__arrow"><Icon name="arrow-right" size={16} /></span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="more-link reveal"><a href="/services/">Compare all services <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Simple steps to fresher laundry.</h2>
        <p class="lead">Three taps. Zero hassle. Your laundry, handled end-to-end.</p>
      </div>
      <ol class="steps swipe">
        {
          steps.map((s, i) => (
            <li class="step">
              <div class="step__card dots-bg">
                <PhoneMock {...s.screen} />
              </div>
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="swipe-hint">Swipe to see all steps <Icon name="arrow-right" size={14} /></p>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Simple, transparent pricing.</h2>
        <p class="lead">{rupees(pricing.perKg)} per kg for wash, fold and iron. Take a monthly pack and save 10%. Pickup and delivery are free within 5 km of HSR Layout.</p>
      </div>
      <div class="plans swipe" data-plans>
        {
          plans.map((p) => (
            <article class:list={['plan', { 'plan--featured': p.featured }]} data-featured={p.featured ? 'true' : undefined}>
              <h3>{p.name}</h3>
              <p class="plan__tagline">{p.tagline}</p>
              <p class="plan__price">
                {p.from && <small class="plan__from">from </small>}
                {rupees(p.rate)}
                <span>/kg</span>
                {p.id === 'monthly' && <s class="plan__was">{rupees(pricing.perKg)}</s>}
              </p>
              {p.id === 'business' && (
                <ul class="tiers" aria-label="Business volume rates">
                  {pricing.businessTiers.map((t) => (
                    <li>
                      <span>{t.maxKg ? `${t.minKg}–${t.maxKg} kg a month` : `${t.minKg} kg+ a month`}</span>
                      <strong>{rupees(tierRate(t.discount))}/kg</strong>
                    </li>
                  ))}
                </ul>
              )}
              {p.id === 'monthly' && (
                <div class="pack" data-pack>
                  <div class="pack__sizes" role="radiogroup" aria-label="Monthly pack size">
                    {pricing.packSizes.map((kg) => (
                      <button type="button" role="radio" aria-checked={kg === defaultPack ? 'true' : 'false'} class:list={['pack__size', { 'is-on': kg === defaultPack }]} data-kg={kg} data-price={rupees(packPrice(kg))} data-save={rupees(fullPrice(kg) - packPrice(kg))}>
                        {kg} kg
                      </button>
                    ))}
                  </div>
                  <p class="pack__total">
                    <strong data-pack-price>{rupees(packPrice(defaultPack))}</strong> a month <span data-pack-save>· you save {rupees(fullPrice(defaultPack) - packPrice(defaultPack))}</span>
                  </p>
                </div>
              )}
              <ul>
                {p.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={wa()}
                {...ext}
                class:list={['btn btn--block', p.featured ? 'btn--white' : 'btn--primary']}
                data-flow={p.id === 'payg' ? 'pickup' : p.id === 'business' ? 'business' : 'plan'}
                data-flow-plan={p.id === 'monthly' ? `monthly-${defaultPack}` : p.id}
                data-plan-cta={p.id}
              >
                {p.cta}
              </a>
            </article>
          ))
        }
      </div>
      <p class="swipe-hint">Swipe to compare plans <Icon name="arrow-right" size={14} /></p>
      <p class="pricing__note">
        Not sure what a kilo looks like? It's about 5 T-shirts, or 2 bath towels. Dry cleaning, shoe, curtain and comforter cleaning and stain removal are priced per item.{' '}
        <a href={wa(msg.question)} {...ext} data-flow="question">Ask us for a quote</a>.
      </p>
      <PlanFinder />
    </div>
  </section>

  <!-- Locations -->
  <section id="locations" class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Self-laundry spots, coming soon.</h2>
        <p class="lead">Prefer doing it yourself? These are the neighbourhoods planned for future dhobermans self-service spots. Tap one to get notified when it opens.</p>
      </div>
      <div class="locations">
        <div class="map reveal" role="img" aria-label="Illustrative map of planned locations in Bangalore">
          <span class="map__label map__label--l">Bangalore</span>
          <span class="map__label map__label--r">Illustrative map</span>
          {
            locations.map((l) => (
              <span class="map__pin" style={`left:${l.x}%;top:${l.y}%`}>
                <span class="dot" />
                {l.name}
              </span>
            ))
          }
        </div>
        <ul class="loc-list">
          {
            locations.map((l) => (
              <li class="reveal">
                <a class="loc" href={wa(msg.location(l.name, l.address))} {...ext} data-flow="location" data-flow-location={`${l.name} (${l.address})`}>
                  <span class="loc__icon"><Icon name="map-pin" size={18} /></span>
                  <div>
                    <h3>{l.name}</h3>
                    <p>{l.address}</p>
                  </div>
                  <span class="loc__notify">Notify me <Icon name="arrow-right" size={14} /></span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Care -->
  <section id="care" class="section section--surface">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Care for what you wear.</h2>
        <p class="lead">Our own line of detergents, comforter washes, diffusers, and fragrances, crafted to keep your fabrics and spaces feeling brand new.</p>
      </div>
      <div class="products">
        {
          featuredProducts.map((p) => (
            <a class="product reveal" href="/care/">
              <div class="product__art">
                <Icon name={categoryIcon[p.category]} size={40} stroke={1.5} />
              </div>
              <span class="product__cat">{p.category} · {p.size}</span>
              <h3>{p.name}</h3>
              <p>{p.short}</p>
              <span class="product__price">{p.price}</span>
            </a>
          ))
        }
      </div>
      <div class="section-cta">
        <a href="/care/" class="btn btn--primary"><Icon name="bag" size={18} /> Shop the full collection</a>
      </div>
    </div>
  </section>

  <!-- Stain SOS and care label decoder -->
  <section id="stain-sos" class="section section--dark">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Spilled something? Act fast.</h2>
        <p class="lead">First aid for common stains, and a decoder for those tiny care-label symbols.</p>
      </div>
      <div class="lab" data-lab>
        <div class="lab__switch" role="tablist" aria-label="Laundry tools">
          <button type="button" role="tab" id="labtab-stains" aria-controls="lab-stains" aria-selected="true">Stain SOS</button>
          <button type="button" role="tab" id="labtab-labels" aria-controls="lab-labels" aria-selected="false" tabindex="-1">Care label decoder</button>
        </div>
        <div id="lab-stains" role="tabpanel" aria-labelledby="labtab-stains"><StainSOS /></div>
        <div id="lab-labels" role="tabpanel" aria-labelledby="labtab-labels" hidden><CareLabels /></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Frequently asked questions.</h2>
      </div>
      <div class="faqs">
        {
          faqs.map((f) => (
            <details class="faq" name="faq">
              <summary>
                {f.q}
                <Icon name="chevron-down" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
        <a class="faq-more" href={wa(msg.question)} {...ext} data-flow="question">
          <span>Still have a question?</span>
          <strong><Icon name="whatsapp" size={18} /> Ask us on WhatsApp</strong>
        </a>
        <div class="help">
          <a href={wa(msg.question)} {...ext} data-flow="question" data-flow-topic="track"><Icon name="truck" size={16} /> Where is my order?</a>
          <a href={wa(msg.question)} {...ext} data-flow="question" data-flow-topic="reschedule"><Icon name="calendar" size={16} /> Reschedule a pickup</a>
          <a href={wa(msg.question)} {...ext} data-flow="question" data-flow-topic="issue"><Icon name="shield" size={16} /> Report an issue</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Book -->
  <section id="book" class="section section--surface">
    <div class="container" id="contact">
      <div class="book reveal">
        <div class="fizz" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <h2 class="h2">Ready to simplify laundry?</h2>
        <p class="lead">Tell us what needs care and when. You'll see your message before it opens in WhatsApp.</p>
        <div class="book__actions">
          <a href={wa()} {...ext} class="btn btn--wa" data-flow="pickup"><Icon name="whatsapp" size={20} /> Book a pickup</a>
          <a href={wa(msg.question)} {...ext} class="btn btn--ghost" data-flow="question">Ask a question</a>
        </div>
        <ul class="book__points">
          <li><Icon name="check-circle" size={18} />24-hour turnaround</li>
          <li><Icon name="check-circle" size={18} />Free pickup within 5 km</li>
          <li><Icon name="check-circle" size={18} />{rupees(pricing.perKg)}/kg wash, fold &amp; iron</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  import { nextPickup } from '../lib/slots';
  import { distanceKm } from '../lib/geo';
  import { profile, lastOrder } from '../lib/store';
  import { site } from '../config';

  const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

  // Hero: the next pickup window, when it comes back, and how long is left to book it.
  const renderPromise = () => {
    const box = document.querySelector<HTMLElement>('[data-promise]');
    const n = box ? nextPickup() : null;
    if (!box || !n) return;
    box.querySelector('[data-promise-pickup]')!.textContent = n.pickup;
    box.querySelector('[data-promise-back]')!.textContent = `By ${n.back}`;
    const h = Math.floor(n.minutesLeft / 60);
    const m = n.minutesLeft % 60;
    const left = h ? `${h} h${m ? ` ${m} min` : ''}` : `${m} min`;
    box.querySelector('[data-promise-note]')!.textContent =
      `${n.minutesLeft <= 360 ? `Book in the next ${left} for this slot.` : `Book by ${n.cutoff} for this slot.`} Free pickup within ${site.freeRadiusKm} km.`;
  };
  window.setInterval(renderPromise, 30000);

  // Hero: one-tap repeat of the last pickup for returning customers.
  const renderAgain = () => {
    const btn = document.querySelector<HTMLElement>('[data-again]');
    if (!btn) return;
    const last = lastOrder.get();
    btn.hidden = !last;
    if (!last) return;
    const first = (profile.get().name ?? '').split(' ')[0];
    const what = last.services.length > 1 ? `${last.services[0]} + ${last.services.length - 1} more` : last.services[0];
    btn.querySelector('[data-again-text]')!.textContent = `${first ? `Welcome back, ${cap(first)}. ` : ''}Repeat ${what}`;
  };
  document.addEventListener('dhb:booked', renderAgain);

  // "Check my distance": is this visitor inside the free pickup zone?
  const distanceCheck = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-distance]');
    const out = document.querySelector<HTMLElement>('[data-distance-result]');
    if (!btn || !out || btn.dataset.ready) return;
    btn.dataset.ready = 'true';
    const show = (text: string, cls = '') => {
      out.className = `fact__result ${cls}`;
      out.textContent = text;
    };
    btn.addEventListener('click', () => {
      if (!('geolocation' in navigator)) return show('Location is not available in this browser. You can pin your address on a map when you book.', 'is-far');
      show('Finding your location...');
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const pin = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          const km = distanceKm({ lat: site.base.lat, lng: site.base.lng }, pin);
          if (km <= site.freeRadiusKm) show(`You're about ${km.toFixed(1)} km away: pickup and delivery are free.`, 'is-ok');
          else show(`You're about ${km.toFixed(1)} km away, outside our free ${site.freeRadiusKm} km zone. Book anyway and we'll confirm the delivery charge.`, 'is-far');
          profile.save({ ...profile.get(), pin }); // reused when they book, so they don't share it twice
        },
        () => show('Location is blocked. You can pin your address on a map when you book.', 'is-far'),
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 },
      );
    });
  };

  // Stain SOS / care label decoder switch.
  const labSwitch = () => {
    const root = document.querySelector<HTMLElement>('[data-lab]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.lab__switch [role="tab"]')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () =>
        tabs.forEach((x) => {
          const on = x === tab;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
        }),
      ),
    );
  };

  document.addEventListener('astro:page-load', () => {
    renderPromise();
    renderAgain();
    distanceCheck();
    labSwitch();
    const again = document.querySelector<HTMLElement>('[data-again]');
    if (again && !again.dataset.ready) {
      again.dataset.ready = 'true';
      again.addEventListener('click', () => document.dispatchEvent(new CustomEvent('dhb:flow', { detail: { intent: 'pickup', again: true } })));
    }

    // Monthly pack size picker.
    const pack = document.querySelector<HTMLElement>('[data-pack]');
    if (pack && !pack.dataset.ready) {
      pack.dataset.ready = 'true';
      const cta = document.querySelector<HTMLElement>('[data-plan-cta="monthly"]');
      pack.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kg]');
        if (!b) return;
        pack.querySelectorAll<HTMLButtonElement>('[data-kg]').forEach((x) => {
          x.classList.toggle('is-on', x === b);
          x.setAttribute('aria-checked', String(x === b));
        });
        pack.querySelector('[data-pack-price]')!.textContent = b.dataset.price!;
        pack.querySelector('[data-pack-save]')!.textContent = `· you save ${b.dataset.save}`;
        if (cta) cta.dataset.flowPlan = `monthly-${b.dataset.kg}`;
      });
    }

    // On phones, open the pricing row on the featured plan.
    const row = document.querySelector<HTMLElement>('[data-plans]');
    const featured = row?.querySelector<HTMLElement>('[data-featured]');
    if (row && featured && window.innerWidth <= 720) {
      row.scrollLeft += featured.getBoundingClientRect().left - row.getBoundingClientRect().left - (row.clientWidth - featured.clientWidth) / 2;
    }
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 7vw, 96px);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 0% 100%, rgba(0, 123, 255, 0.12), transparent 70%),
      radial-gradient(40% 50% at 100% 0%, rgba(0, 123, 255, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 520px;
    margin-top: 32px;
  }

  .hero__actions .btn {
    width: 100%;
    padding-inline: 12px;
  }

  @media (max-width: 480px) {
    .hero__actions {
      grid-template-columns: 1fr;
    }
  }

  .hero__app {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .hero__app:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kinetic .w {
    display: inline-block;
    animation: word-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 70ms + 60ms);
  }

  @keyframes word-rise {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__again {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 14px;
    padding: 0 14px;
    border: 1px solid var(--brand-200);
    border-radius: var(--radius-btn);
    background: var(--brand-50);
    color: var(--brand-700);
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .promise {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 4px 16px;
    max-width: 520px;
    margin-top: 24px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-sm);
  }

  .promise__cell {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .promise__k {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .promise__cell strong {
    color: var(--ink);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .promise__arrow {
    color: var(--subtle);
  }


  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 rgba(31, 170, 89, 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgba(31, 170, 89, 0);
    }
  }

  .promise__note {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  .hero__media {
    position: relative;
    padding: 28px 0 28px 28px;
  }

  .hero__frame {
    overflow: hidden;
    aspect-ratio: 4 / 4.4;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    border: 1px solid rgba(231, 234, 240, 0.9);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }

  .float-card div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .float-card strong {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .float-card span:not(.float-card__icon) {
    color: var(--muted);
    font-size: 13px;
  }

  .float-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
  }

  .float-card__icon--ok {
    background: var(--brand);
    color: var(--white);
  }

  .float-card--top {
    top: 56px;
    left: 0;
  }

  .float-card--bottom {
    right: -12px;
    bottom: 64px;
    animation-delay: -3s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Why us */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .fact__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 8px;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
  }

  .fact h3 {
    color: var(--ink);
    font-size: 21px;
    line-height: 1.3;
  }

  .fact p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .fact__btn {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    margin-top: auto;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .fact__btn:hover {
    border-color: var(--brand);
  }

  .fact__btn :global(svg) {
    color: var(--brand);
  }

  .fact .fact__result {
    font-size: 14px;
  }

  .fact__result:empty {
    display: none;
  }

  .fact .fact__result.is-ok {
    color: var(--wa);
  }

  .fact .fact__result.is-far {
    color: #b54708;
  }

  .assure {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 16px 0 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    list-style: none;
  }

  .assure li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 20px 24px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .assure li + li {
    border-left: 1px solid var(--line);
  }

  .assure :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--brand);
  }

  .assure strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Services */
  .more-link {
    margin-top: 28px;
    text-align: center;
  }

  .more-link a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--brand-600);
    font-weight: 600;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .service {
    display: flex;
    flex-direction: column;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .service:hover {
    border-color: var(--brand-200);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .service__img {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .service__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .service:hover .service__img :global(img) {
    transform: scale(1.05);
  }

  .service__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 6px 6px;
  }

  .service h3 {
    font-size: 17px;
    font-weight: 600;
  }

  .service__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    transition: all 0.2s ease;
  }

  .service:hover .service__arrow {
    background: var(--brand);
    color: var(--white);
  }

  /* Steps */
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto auto;
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 404px;
    left: calc(100% / 6);
    right: calc(100% / 6);
    border-top: 2px dashed rgba(255, 255, 255, 0.22);
  }

  .step {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    justify-items: center;
    text-align: center;
  }

  .step__card {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 404px;
    padding-top: 40px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--brand);
  }

  .step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 4px solid var(--dark);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    font-size: 18px;
    font-weight: 700;
  }

  .step h3 {
    max-width: 300px;
    margin-top: 16px;
    font-size: 22px;
  }

  .step p {
    max-width: 300px;
    margin-top: 8px;
  }

  .plan .tiers {
    display: grid;
    flex: none;
    gap: 6px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .tiers li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 15px;
  }

  .tiers strong {
    color: var(--ink);
  }

  /* Plans */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 20px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .plan h3 {
    font-size: 22px;
  }

  .plan__tagline {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 24px;
    color: var(--ink);
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
  }

  .plan__price span,
  .plan__from {
    color: var(--muted);
    font-size: 16px;
    font-weight: 500;
  }

  .plan__was {
    margin-left: 8px;
    color: var(--muted);
    font-size: 18px;
    font-weight: 500;
  }

  .pack {
    margin-top: 20px;
  }

  .pack__sizes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 4px;
    border-radius: var(--radius-btn);
    background: rgba(255, 255, 255, 0.15);
  }

  .pack__size {
    min-height: 40px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .pack__size.is-on {
    background: var(--white);
    color: var(--brand);
  }

  .pack__total {
    margin-top: 10px;
    font-size: 15px;
  }

  .pack__total strong {
    color: var(--white);
    font-size: 18px;
  }

  .plan ul {
    display: grid;
    align-content: start;
    gap: 12px;
    flex: 1;
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
  }

  .plan li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
  }

  .plan li :global(svg) {
    flex: none;
    color: var(--brand);
  }

  .plan--featured {
    border-color: var(--brand);
    background: var(--brand);
    color: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-lg);
  }

  .plan--featured h3,
  .plan--featured .plan__price {
    color: var(--white);
  }

  .plan--featured .plan__tagline,
  .plan--featured .plan__price span,
  .plan--featured .plan__was {
    color: rgba(255, 255, 255, 0.72);
  }

  .plan--featured li :global(svg) {
    color: var(--white);
  }

  .pricing__note {
    max-width: 640px;
    margin: 28px auto 0;
    color: var(--muted);
    font-size: 15px;
    text-align: center;
  }

  .pricing__note a {
    color: var(--brand);
    font-weight: 600;
  }

  /* Locations */
  .locations {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 24px;
  }

  .map {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(45% 55% at 45% 45%, rgba(0, 123, 255, 0.1), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 44px 44px,
      var(--surface);
  }

  .map__label {
    position: absolute;
    top: 18px;
    color: var(--subtle);
    font-size: 13px;
    font-weight: 500;
  }

  .map__label--l {
    left: 22px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .map__label--r {
    right: 22px;
  }

  .map__pin {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px 7px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .loc-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .loc {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .loc:hover {
    border-color: var(--brand-200);
    box-shadow: var(--shadow-sm);
  }

  .loc > div {
    flex: 1;
    min-width: 0;
  }

  .loc__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
  }

  .loc h3 {
    font-size: 17px;
  }

  .loc p {
    color: var(--muted);
    font-size: 15px;
  }

  .loc__notify {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    color: var(--brand);
    font-size: 14px;
    font-weight: 600;
  }

  /* Care */
  .products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .product {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 10px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .product:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .product__art {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 16px;
    border-radius: var(--radius-sm);
    background: linear-gradient(160deg, var(--brand-50), #ffffff 90%);
    color: var(--brand);
  }

  .product__cat {
    margin-inline: 10px;
    color: var(--subtle);
    font-size: 14px;
  }

  .product h3 {
    margin: 4px 10px 0;
    font-size: 18px;
  }

  .product p {
    margin: 6px 10px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .product__price {
    margin: 12px 10px 0;
    color: var(--ink);
    font-size: 18px;
    font-weight: 600;
  }

  /* FAQ */
  .faqs {
    display: grid;
    gap: 10px;
    max-width: 760px;
    margin-inline: auto;
  }

  .faq {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: border-color 0.2s ease;
  }

  .faq[open] {
    border-color: var(--brand-200);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary :global(svg) {
    flex: none;
    color: var(--muted);
    transition: transform 0.25s ease;
  }

  .faq[open] summary :global(svg) {
    transform: rotate(180deg);
    color: var(--brand);
  }

  .faq p {
    padding: 0 22px 22px;
    color: var(--muted);
  }

  .faq-more {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 8px;
    padding: 20px 22px;
    border-radius: var(--radius-lg);
    background: var(--brand-50);
    color: var(--ink);
    font-weight: 500;
  }

  .faq-more strong {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--wa);
    font-weight: 600;
  }

  /* Book */
  .book {
    position: relative;
    display: grid;
    justify-items: center;
    overflow: hidden;
    padding: clamp(40px, 6vw, 72px) clamp(20px, 4vw, 48px);
    border-radius: var(--radius-xl);
    background: linear-gradient(140deg, #e3f0ff 0%, #f4f9ff 55%, #e9f3ff 100%);
    text-align: center;
  }

  .book > :not(.fizz) {
    position: relative;
    z-index: 1;
  }

  .book .h2,
  .book .lead {
    margin-inline: auto;
  }

  .book__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .book__points {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 24px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .book__points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 500;
  }

  .book__points :global(svg) {
    color: var(--brand);
  }

  /* Laundry lab switch */
  .lab__switch {
    display: flex;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 24px;
    padding: 4px;
    border-radius: var(--radius-btn);
    background: rgba(255, 255, 255, 0.08);
  }

  .lab__switch button {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .lab__switch button[aria-selected='true'] {
    background: var(--white);
    color: var(--ink);
  }

  /* Help shortcuts */
  .help {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
  }

  .help a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    transition: border-color 0.2s ease;
  }

  .help a:hover {
    border-color: var(--brand-200);
  }

  .help :global(svg) {
    color: var(--brand);
  }

  /* Bubbles */
  .fizz {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fizz i {
    position: absolute;
    bottom: -44px;
    border: 1.5px solid rgba(0, 123, 255, 0.22);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.95), rgba(0, 123, 255, 0.08));
    opacity: 0;
    animation: fizz 10s linear infinite;
  }

  .fizz i:nth-child(1) { left: 5%; width: 22px; height: 22px; animation-delay: 0s; }
  .fizz i:nth-child(2) { left: 14%; width: 38px; height: 38px; animation-delay: 3.2s; }
  .fizz i:nth-child(3) { left: 27%; width: 14px; height: 14px; animation-delay: 6.1s; }
  .fizz i:nth-child(4) { left: 71%; width: 16px; height: 16px; animation-delay: 1.4s; }
  .fizz i:nth-child(5) { left: 82%; width: 42px; height: 42px; animation-delay: 4.6s; }
  .fizz i:nth-child(6) { left: 93%; width: 20px; height: 20px; animation-delay: 7.7s; }
  .fizz i:nth-child(7) { left: 40%; width: 10px; height: 10px; animation-delay: 8.6s; }
  .fizz i:nth-child(8) { left: 60%; width: 12px; height: 12px; animation-delay: 2.3s; }

  @keyframes fizz {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    10% {
      opacity: 0.85;
    }
    100% {
      transform: translateY(-560px);
      opacity: 0;
    }
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .services,
